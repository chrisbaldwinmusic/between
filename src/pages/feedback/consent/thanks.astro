---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/feedback.css';
---
<BaseLayout title="Thank you · Photo, video and audio permission · The Space Between" description="Thanks for saying yes." nav="minimal">
  <main id="main">
    <div class="fb-hero">
      <div class="container fb-hero__inner">
        <p class="fb-hero__eyebrow">Permission received</p>
        <h1 class="fb-hero__title">Thank you</h1>
        <p class="fb-hero__sub">
          That helps us tell Burton's story with the people in it. If you ever change your mind,
          email <a href="mailto:hello@sonicboom.org.uk?subject=Withdrawing%20my%20permission%20-%20The%20Space%20Between">hello@sonicboom.org.uk</a>
          and we'll stop using it.
        </p>
      </div>
    </div>
    <div class="fb-body">
      <div class="container fb-body__inner">
        <p class="fb-note">Believe in the Power of Music.</p>
      </div>
    </div>
  </main>
</BaseLayout>
