---
// Public post-event survey: the five questions from the ACE evaluation plan. Plain HTML form
// post (works without JS), open to everyone with no PIN. Answers go to D1 via /api/feedback/survey.
// Rendered per request so it opens by itself on the day of the event (UK time).
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import StayInLoop from '../../components/StayInLoop.astro';
import SurveyForm from '../../components/SurveyForm.astro';
import { eventBySlug, surveyOpen, onTheDay } from '../../lib/feedback.js';
import { dateFixed } from '../../lib/dates.js';
import '../../styles/feedback.css';

const event = eventBySlug(Astro.params.slug);
if (!event) return Astro.redirect('/feedback');
const open = surveyOpen(event);
const [y, m, d] = event.date.split('-').map(Number);
const weekday = new Date(Date.UTC(y, m - 1, d)).toLocaleDateString('en-GB', { weekday: 'long', timeZone: 'UTC' });
---
<BaseLayout
  title={`Your feedback: ${event.name} · The Space Between`}
  description={`Two minutes, five questions: tell us how ${event.name} went.`}
  nav="minimal"
>
  <main id="main">
    <div class="fb-hero" style={`--accent:${event.accent}`}>
      <div class="container fb-hero__inner">
        <p class="fb-hero__eyebrow">{event.name} · {dateFixed(event) ? `${weekday} ${d} ${event.month}` : event.month}</p>
        <h1 class="fb-hero__title">{open ? 'How was it?' : 'See you there'}</h1>
        <p class="fb-hero__sub">
          {open
            ? 'Five quick questions, about two minutes. Every answer shapes the next night, and helps build the case for our ambition: a permanent home for grassroots music in Burton.'
            : `This is where you'll tell us how ${event.name} went. The questions open ${onTheDay(event)} of the event.`}
        </p>
      </div>
    </div>

    <div class="fb-body">
      <div class="container fb-body__inner">
        {!open && <StayInLoop medium="feedback-early" />}
        {open && <SurveyForm event={event} />}
      </div>
    </div>
  </main>
</BaseLayout>
