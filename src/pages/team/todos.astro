---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import todos from '../../data/todos.json';

const authEmail = Astro.request.headers.get('Cf-Access-Authenticated-User-Email');

const areas = [...new Set(todos.map(t => t.area))];
---
<BaseLayout title="To-dos · Between Ops" nav="internal" authEmail={authEmail}>
  <main id="main">
    <section class="todo-section">
      <div class="container">
        <h1 class="todo-heading">To-dos</h1>
        <p class="todo-intro">
          Edit <code>src/data/todos.json</code> to add, reassign or clear items.
        </p>

        {areas.map(area => (
          <div class="todo-group">
            <h2 class="todo-group__heading">{area}</h2>
            <ul class="todo-list" role="list">
              {todos.filter(t => t.area === area).map(t => (
                <li class="todo-item">
                  <p class="todo-item__task">{t.task}</p>
                  <p class="todo-item__owner">{t.owner}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .todo-section {
    background: var(--ink);
    padding-block: clamp(var(--space-8), 6vw, var(--space-12));
    min-height: calc(100svh - var(--nav-h));
  }

  .todo-heading {
    font-family: var(--font-body);
    color: var(--paper);
    font-size: var(--text-2xl);
    margin-bottom: var(--space-3);
  }

  .todo-intro {
    color: var(--body);
    font-size: var(--text-sm);
    max-width: 65ch;
    margin-bottom: var(--space-8);
  }
  .todo-intro code {
    font-family: monospace;
    font-size: 0.9em;
    background: rgba(255,255,255,0.08);
    color: var(--paper);
    padding: 0.1em 0.4em;
    border-radius: var(--radius-sm);
  }

  .todo-group { margin-bottom: var(--space-8); }
  .todo-group:last-child { margin-bottom: 0; }

  .todo-group__heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--body);
    margin-bottom: var(--space-2);
  }

  .todo-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .todo-item {
    background: var(--ink-soft);
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  @media (min-width: 640px) {
    .todo-item {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-4);
    }
  }

  .todo-item__task {
    font-size: var(--text-sm);
    color: var(--paper);
    line-height: 1.5;
    max-width: none;
  }

  .todo-item__owner {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--ember);
    white-space: nowrap;
    max-width: none;
  }
</style>
