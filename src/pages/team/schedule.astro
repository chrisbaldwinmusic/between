---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import schedule from '../../data/schedule.json';

const authEmail = Astro.request.headers.get('Cf-Access-Authenticated-User-Email');

const today = new Date().toISOString().slice(0, 10);

function status(start: string, end: string) {
  if (today < start) return 'upcoming';
  if (today > end) return 'done';
  return 'active';
}

const statusLabel: Record<string, string> = {
  upcoming: 'Upcoming',
  active: 'In progress',
  done: 'Done',
};

function fmt(d: string) {
  const [y, m, day] = d.split('-').map(Number);
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  return `${day} ${months[m - 1]} ${y}`;
}

// Active items first, then upcoming (soonest first), then done (most recent first)
const order = { active: 0, upcoming: 1, done: 2 };
const sorted = [...schedule].sort((a, b) => {
  const sa = status(a.start, a.end), sb = status(b.start, b.end);
  if (order[sa] !== order[sb]) return order[sa] - order[sb];
  return a.start.localeCompare(b.start);
});
---
<BaseLayout title="Schedule · Between Ops" nav="internal" authEmail={authEmail}>
  <main id="main">
    <section class="sched-section">
      <div class="container">
        <h1 class="sched-heading">Schedule</h1>
        <p class="sched-intro">
          22 Sept 2026 – 30 Nov 2027, from the ACE application. Status is computed from today's
          date. Edit <code>src/data/schedule.json</code> to update.
        </p>

        <ol class="sched-list" role="list">
          {sorted.map(item => {
            const s = status(item.start, item.end);
            return (
              <li class={`sched-item sched-item--${s}`}>
                <div class="sched-item__dates">
                  <span class="sched-item__range">{fmt(item.start)} – {fmt(item.end)}</span>
                  <span class="sched-item__status">{statusLabel[s]}</span>
                </div>
                <p class="sched-item__task">{item.task}</p>
                <p class="sched-item__owner">{item.owner}</p>
              </li>
            );
          })}
        </ol>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .sched-section {
    background: var(--ink);
    padding-block: clamp(var(--space-8), 6vw, var(--space-12));
    min-height: calc(100svh - var(--nav-h));
  }

  .sched-heading {
    font-family: var(--font-body);
    color: var(--paper);
    font-size: var(--text-2xl);
    margin-bottom: var(--space-3);
  }

  .sched-intro {
    color: var(--body);
    font-size: var(--text-sm);
    max-width: 65ch;
    margin-bottom: var(--space-6);
  }
  .sched-intro code {
    font-family: monospace;
    font-size: 0.9em;
    background: rgba(255,255,255,0.08);
    color: var(--paper);
    padding: 0.1em 0.4em;
    border-radius: var(--radius-sm);
  }

  .sched-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .sched-item {
    background: var(--ink-soft);
    border-left: 3px solid var(--body);
    padding: var(--space-3) var(--space-4);
    min-width: 0;
  }
  .sched-item--active   { border-left-color: var(--red); }
  .sched-item--upcoming { border-left-color: var(--ember); }
  .sched-item--done     { border-left-color: #4caf50; opacity: 0.6; }

  .sched-item__dates {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: 0.35rem;
  }

  .sched-item__range {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--body);
    letter-spacing: 0.02em;
  }

  .sched-item__status {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--body);
    white-space: nowrap;
  }
  .sched-item--active .sched-item__status   { color: var(--red); }
  .sched-item--upcoming .sched-item__status { color: var(--ember); }
  .sched-item--done .sched-item__status     { color: #4caf50; }

  .sched-item__task {
    font-size: var(--text-sm);
    color: var(--paper);
    line-height: 1.5;
    margin-bottom: 0.35rem;
    max-width: none;
  }

  .sched-item__owner {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--ember);
    max-width: none;
  }
</style>
