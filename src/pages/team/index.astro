---
import BaseLayout from '../../layouts/BaseLayout.astro';
import team from '../../data/team.json';

const statusLabel: Record<string, string> = {
  confirmed: 'Confirmed',
  expected: 'Expected',
  unconfirmed: 'Unconfirmed',
};
---
<BaseLayout title="Team & roles — The Space Between" nav="internal">
  <main id="main">
    <section class="team-section">
      <div class="container">
        <h1 class="team-heading">People &amp; responsibilities</h1>
        <p class="team-intro">
          The delivery team for The Space Between, as named in the Arts Council England
          application (Sept 2026 – Nov 2027). Edit <code>src/data/team.json</code> and redeploy
          to keep this current.
        </p>

        <ul class="team-grid" role="list">
          {team.map(person => (
            <li class={`person-card person-card--${person.status}`}>
              <div class="person-card__head">
                <h2 class="person-card__name">{person.name}</h2>
                <span class="person-card__status">{statusLabel[person.status] ?? person.status}</span>
              </div>
              <p class="person-card__role">{person.role}</p>
              <p class="person-card__remit">{person.remit}</p>
              <a class="person-card__email" href={`mailto:${person.email}`}>{person.email}</a>
              {person.source && <p class="person-card__source">{person.source}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .team-section {
    background: var(--paper);
    padding-block: clamp(var(--space-10), 7vw, var(--space-16));
    min-height: calc(100svh - var(--nav-h));
  }

  .team-heading {
    color: var(--ink);
    margin-bottom: var(--space-3);
  }

  .team-intro {
    color: var(--ink-soft);
    max-width: 60ch;
    margin-bottom: var(--space-8);
  }
  .team-intro code {
    font-family: monospace;
    font-size: 0.9em;
    background: rgba(26, 18, 18, 0.06);
    padding: 0.1em 0.4em;
    border-radius: var(--radius-sm);
  }

  .team-grid {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .team-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1000px) {
    .team-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .person-card {
    background: #fff;
    border-radius: var(--radius-md);
    border-left: 4px solid var(--body);
    padding: var(--space-5);
    box-shadow: 0 2px 12px rgba(26, 18, 18, 0.08);
    min-width: 0;
  }
  .person-card--confirmed { border-left-color: #2d5a1b; }
  .person-card--expected  { border-left-color: var(--ember); }
  .person-card--unconfirmed { border-left-color: var(--red); }

  .person-card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-1);
  }

  .person-card__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--ink);
  }

  .person-card__status {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .person-card__role {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-soft);
    margin-bottom: var(--space-2);
  }

  .person-card__remit {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    line-height: 1.6;
    margin-bottom: var(--space-3);
    max-width: none;
  }

  .person-card__email {
    display: inline-block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--red);
    text-decoration: none;
    word-break: break-all;
  }
  .person-card__email:hover { text-decoration: underline; }

  .person-card__source {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--body);
    max-width: none;
  }
</style>
