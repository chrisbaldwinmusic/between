---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import WipNotice from '../../components/WipNotice.astro';
import TeamWhy from '../../components/TeamWhy.astro';
import MyTodos from '../../components/MyTodos.astro';
import { getEmail, isLead, isCommunity } from '../../lib/team-access.js';
import { ukToday, addDays, eventWhen, materialsReady } from '../../lib/dates.js';
import { fmtDate } from '../../lib/metrics.js';
import events from '../../data/events.json';

const authEmail = Astro.request.headers.get('Cf-Access-Authenticated-User-Email');
const lead = isLead(getEmail(Astro.request));
const community = isCommunity(getEmail(Astro.request));
// Community managers: surveys to preview and share, from the 1st of the event's month until a
// fortnight after it.
const shareable = community ? events.filter(e => materialsReady(e) && e.date >= addDays(ukToday(), -14)) : [];
const db = Astro.locals.runtime?.env?.OPS_DB;

let team = [];
let openTodos = 0;
let activeSchedule = 0;

if (db) {
  const [teamRes, todosRes, scheduleRes] = await Promise.all([
    db.prepare('SELECT * FROM team_members ORDER BY id ASC').all(),
    db.prepare('SELECT COUNT(*) AS n FROM todos WHERE done = 0').first(),
    db.prepare(`SELECT COUNT(*) AS n FROM schedule_items
                WHERE (status_override = 'blocked')
                   OR (status_override IS NULL AND ? BETWEEN start_date AND end_date)`).bind(ukToday()).first(),
  ]);
  team = teamRes.results;
  openTodos = todosRes?.n ?? 0;
  activeSchedule = scheduleRes?.n ?? 0;
}

const statusLabel: Record<string, string> = {
  confirmed: 'Confirmed',
  expected: 'Expected',
  unconfirmed: 'Unconfirmed',
};
const unconfirmedCount = team.filter(p => p.status === 'unconfirmed').length;

---
<BaseLayout title="Dashboard · Between Ops" nav="internal" authEmail={authEmail}>
  <main id="main">
    <section class="team-section">
      <div class="container">
        <h1 class="team-heading">Dashboard</h1>

        {!lead && <WipNotice />}
        <p class="app-promo">
          <strong>Put Between Ops on your phone</strong> and get your reminders as notifications.
          <a href="/team/help#app">How to</a>
        </p>
        <MyTodos />
        {community && (
          <section class="cm" aria-labelledby="h-cm">
            <h2 class="team-subheading" id="h-cm">Surveys and stories to share</h2>
            {shareable.length > 0 ? (
              <ul class="cm-list" role="list">
                {shareable.map(e => (
                  <li class="cm-item" style={`--accent:${e.accent}`}>
                    <span class="cm-item__name">{e.name}</span>
                    <span class="cm-item__when">{eventWhen(e, d => fmtDate(d, { weekday: 'short', day: 'numeric', month: 'short' }))}</span>
                    <span class="cm-item__links">
                      <a href={`/team/evaluation/survey-preview?e=${e.slug}`}>Survey and share links<span class="visually-hidden"> for {e.name}</span></a>
                      <a href={`/team/evaluation/qr?e=${e.slug}&t=survey`}>QR poster<span class="visually-hidden"> for {e.name}</span></a>
                    </span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="cm-empty">Each event's survey and QR poster appear here from the 1st of its month.</p>
            )}
            <p class="cm-more">
              <a href="/team/stories">Stories to share</a> ·
              <a href="/team/evaluation/survey-report">Survey results</a> ·
              <a href="/team/evaluation/community-report">Community growth</a> ·
              <a href="/team/evaluation/attribution">Which links work</a>
            </p>
          </section>
        )}
        <TeamWhy />

        <ul class="stat-row" role="list">
          <li class="stat">
            <span class="stat__n">{activeSchedule}</span>
            <span class="stat__label">in progress now</span>
          </li>
          {lead && (
            <li class="stat">
              <span class="stat__n">{openTodos}</span>
              <span class="stat__label">open to-dos</span>
            </li>
          )}
          <li class="stat">
            <span class="stat__n">{team.length}</span>
            <span class="stat__label">people on the roster</span>
          </li>
          {unconfirmedCount > 0 && (
            <li class="stat stat--warn">
              <span class="stat__n">{unconfirmedCount}</span>
              <span class="stat__label">unconfirmed role{unconfirmedCount === 1 ? '' : 's'}</span>
            </li>
          )}
        </ul>

        <h2 class="team-subheading">Roster</h2>
        <ul class="team-list" role="list" id="roster-list">
          {team.map(person => (
            <li class={`person-row person-row--${person.status}`} data-id={person.id}>
              <div class="person-row__id">
                <p class="person-row__name">{person.name}</p>
                <p class="person-row__role" data-role="role-text">{person.role}</p>
              </div>
              <p class="person-row__remit" data-role="remit-text">{person.remit}</p>
              <div class="person-row__meta">
                {lead ? (
                  <button class="person-row__status" type="button" data-role="cycle-status">
                    {statusLabel[person.status] ?? person.status}
                  </button>
                ) : (
                  <span class="person-row__status">{statusLabel[person.status] ?? person.status}</span>
                )}
                <a class="person-row__email" href={`mailto:${person.email}`}>{person.email}</a>
              </div>
            </li>
          ))}
        </ul>
        {lead && <p class="team-footnote">Click a status pill to cycle it. Confirmed → Expected → Unconfirmed.</p>}
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const STATUS_CYCLE = ['confirmed', 'expected', 'unconfirmed'];
  const STATUS_LABEL: Record<string, string> = { confirmed: 'Confirmed', expected: 'Expected', unconfirmed: 'Unconfirmed' };

  const listEl = document.getElementById('roster-list');
  if (listEl) {
    listEl.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('[data-role="cycle-status"]') as HTMLButtonElement | null;
      if (!btn) return;
      const li = btn.closest('li.person-row') as HTMLLIElement;
      const id = li.dataset.id;
      const current = STATUS_CYCLE.find(s => btn.textContent?.trim() === STATUS_LABEL[s]) || 'unconfirmed';
      const next = STATUS_CYCLE[(STATUS_CYCLE.indexOf(current) + 1) % STATUS_CYCLE.length];

      li.classList.add('person-row--busy');
      try {
        const res = await fetch(`/api/team/roster/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: next }),
        });
        if (!res.ok) throw new Error('Failed to update');
        li.className = `person-row person-row--${next}`;
        btn.textContent = STATUS_LABEL[next];
      } catch {
        // leave as-is; user can retry
      } finally {
        li.classList.remove('person-row--busy');
      }
    });
  }
</script>

<style>
  .app-promo {
    font-size: var(--text-sm); color: var(--body); margin: 0 0 var(--space-5);
    background: var(--ink-soft); border: 1px solid var(--line); border-radius: var(--radius); padding: var(--space-3) var(--space-4);
  }
  .app-promo strong { color: var(--paper); }
  .app-promo a { color: var(--ember); font-weight: 700; margin-left: 0.25rem; }
  .app-promo a:focus-visible { outline: 3px solid var(--ember); outline-offset: 2px; }
  /* Already using the installed app: no need to ask. */
  @media (display-mode: standalone) { .app-promo { display: none; } }
  .cm { margin-bottom: var(--space-6); }
  .cm-list { list-style: none; margin: 0 0 var(--space-3); padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .cm-item {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem var(--space-3);
    background: var(--ink-soft); border: 1px solid var(--line); border-left: 4px solid var(--accent, var(--ember));
    border-radius: var(--radius); padding: var(--space-3);
  }
  .cm-item__name { font-weight: 700; color: var(--paper); }
  .cm-item__when { font-size: var(--text-xs); color: var(--body); }
  .cm-item__links { flex-basis: 100%; display: flex; flex-wrap: wrap; gap: var(--space-3); font-size: var(--text-sm); }
  .cm a { color: var(--ember); font-weight: 600; }
  .cm a:focus-visible { outline: 3px solid var(--ember); outline-offset: 2px; }
  .cm-empty, .cm-more { font-size: var(--text-sm); color: var(--body); margin: 0 0 var(--space-2); }
  .visually-hidden { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .team-section {
    background: var(--ink);
    padding-block: clamp(var(--space-8), 6vw, var(--space-12));
    min-height: calc(100svh - var(--nav-h));
  }

  .team-heading {
    font-family: var(--font-body);
    color: var(--paper);
    font-size: var(--text-2xl);
    margin-bottom: var(--space-6);
  }

  .team-subheading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--body);
    margin: 0 0 var(--space-3);
  }

  /* ── Stats ────────────────────────────────────────────────────────────── */
  .stat-row {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: var(--space-8);
  }
  @media (min-width: 640px) {
    .stat-row { grid-template-columns: repeat(4, 1fr); }
  }

  .stat {
    background: var(--ink-soft);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .stat__n {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--ember);
    line-height: 1;
  }
  .stat--warn .stat__n { color: var(--red); }
  .stat__label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--body);
  }

  /* ── Roster ───────────────────────────────────────────────────────────── */
  .team-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .person-row {
    background: var(--ink-soft);
    padding: var(--space-3) var(--space-4);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    border-left: 3px solid var(--body);
    transition: opacity 150ms var(--ease-out);
  }
  .person-row--busy { opacity: 0.5; pointer-events: none; }
  .person-row--confirmed { border-left-color: #4caf50; }
  .person-row--expected  { border-left-color: var(--ember); }
  .person-row--unconfirmed { border-left-color: var(--red); }

  @media (min-width: 800px) {
    .person-row {
      grid-template-columns: 12rem 1fr 11rem;
      align-items: center;
      gap: var(--space-4);
    }
  }

  .person-row__name {
    font-family: var(--font-body);
    font-weight: 700;
    color: var(--paper);
    font-size: var(--text-sm);
  }
  .person-row__role {
    font-size: var(--text-xs);
    color: var(--body);
    margin-top: 0.15rem;
  }

  .person-row__remit {
    font-size: var(--text-xs);
    color: var(--body);
    line-height: 1.5;
    max-width: none;
  }

  .person-row__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
  }
  @media (min-width: 800px) {
    .person-row__meta { align-items: flex-end; text-align: right; }
  }

  .person-row__status {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--body);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.15rem 0.5rem;
  }
  .person-row--confirmed .person-row__status { color: #4caf50; border-color: #4caf50; }
  .person-row--expected .person-row__status  { color: var(--ember); border-color: var(--ember); }
  .person-row--unconfirmed .person-row__status { color: var(--red); border-color: var(--red); }
  button.person-row__status:hover { background: rgba(255,255,255,0.06); }
  .person-row__status:focus-visible {
    outline: 3px solid var(--ember);
    outline-offset: 1px;
  }

  .person-row__email {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--ember);
    text-decoration: none;
    word-break: break-all;
  }
  .person-row__email:hover { text-decoration: underline; }

  .team-footnote {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--body);
    margin-top: var(--space-3);
  }
</style>
