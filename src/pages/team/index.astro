---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import team from '../../data/team.json';
import schedule from '../../data/schedule.json';
import todos from '../../data/todos.json';

const authEmail = Astro.request.headers.get('Cf-Access-Authenticated-User-Email');

const statusLabel: Record<string, string> = {
  confirmed: 'Confirmed',
  expected: 'Expected',
  unconfirmed: 'Unconfirmed',
};

const today = new Date().toISOString().slice(0, 10);
const activeCount = schedule.filter(s => today >= s.start && today <= s.end).length;
const unconfirmedCount = team.filter(p => p.status === 'unconfirmed').length;
const todoCount = todos.length;
---
<BaseLayout title="Dashboard · Between Ops" nav="internal" authEmail={authEmail}>
  <main id="main">
    <section class="team-section">
      <div class="container">
        <h1 class="team-heading">Dashboard</h1>

        <ul class="stat-row" role="list">
          <li class="stat">
            <span class="stat__n">{activeCount}</span>
            <span class="stat__label">in progress now</span>
          </li>
          <li class="stat">
            <span class="stat__n">{todoCount}</span>
            <span class="stat__label">open to-dos</span>
          </li>
          <li class="stat">
            <span class="stat__n">{team.length}</span>
            <span class="stat__label">people on the roster</span>
          </li>
          {unconfirmedCount > 0 && (
            <li class="stat stat--warn">
              <span class="stat__n">{unconfirmedCount}</span>
              <span class="stat__label">unconfirmed role{unconfirmedCount === 1 ? '' : 's'}</span>
            </li>
          )}
        </ul>

        <h2 class="team-subheading">Roster</h2>

        <ul class="team-list" role="list">
          {team.map(person => (
            <li class={`person-row person-row--${person.status}`}>
              <div class="person-row__id">
                <p class="person-row__name">{person.name}</p>
                <p class="person-row__role">{person.role}</p>
              </div>
              <p class="person-row__remit">{person.remit}</p>
              <div class="person-row__meta">
                <span class="person-row__status">{statusLabel[person.status] ?? person.status}</span>
                <a class="person-row__email" href={`mailto:${person.email}`}>{person.email}</a>
              </div>
            </li>
          ))}
        </ul>

        <p class="team-footnote">
          Source: ACE application. Edit <code>src/data/team.json</code> to update.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .team-section {
    background: var(--ink);
    padding-block: clamp(var(--space-8), 6vw, var(--space-12));
    min-height: calc(100svh - var(--nav-h));
  }

  .team-heading {
    font-family: var(--font-body);
    color: var(--paper);
    font-size: var(--text-2xl);
    margin-bottom: var(--space-6);
  }

  .team-subheading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--body);
    margin: var(--space-10) 0 var(--space-3);
  }

  /* ── Stats ────────────────────────────────────────────────────────────── */
  .stat-row {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .stat-row { grid-template-columns: repeat(4, 1fr); }
  }

  .stat {
    background: var(--ink-soft);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .stat__n {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--ember);
    line-height: 1;
  }
  .stat--warn .stat__n { color: var(--red); }
  .stat__label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--body);
  }

  /* ── Roster ───────────────────────────────────────────────────────────── */
  .team-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .person-row {
    background: var(--ink-soft);
    padding: var(--space-3) var(--space-4);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    border-left: 3px solid var(--body);
  }
  .person-row--confirmed { border-left-color: #4caf50; }
  .person-row--expected  { border-left-color: var(--ember); }
  .person-row--unconfirmed { border-left-color: var(--red); }

  @media (min-width: 800px) {
    .person-row {
      grid-template-columns: 13rem 1fr 12rem;
      align-items: center;
      gap: var(--space-4);
    }
  }

  .person-row__name {
    font-family: var(--font-body);
    font-weight: 700;
    color: var(--paper);
    font-size: var(--text-sm);
  }
  .person-row__role {
    font-size: var(--text-xs);
    color: var(--body);
    margin-top: 0.15rem;
  }

  .person-row__remit {
    font-size: var(--text-xs);
    color: var(--body);
    line-height: 1.5;
    max-width: none;
  }

  .person-row__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
  }
  @media (min-width: 800px) {
    .person-row__meta { align-items: flex-end; text-align: right; }
  }

  .person-row__status {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--body);
  }
  .person-row--confirmed .person-row__status { color: #4caf50; }
  .person-row--expected .person-row__status  { color: var(--ember); }
  .person-row--unconfirmed .person-row__status { color: var(--red); }

  .person-row__email {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--ember);
    text-decoration: none;
    word-break: break-all;
  }
  .person-row__email:hover { text-decoration: underline; }

  /* ── Footnote ─────────────────────────────────────────────────────────── */
  .team-footnote {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--body);
    margin-top: var(--space-6);
  }
  .team-footnote code {
    font-family: monospace;
    background: rgba(255,255,255,0.08);
    color: var(--paper);
    padding: 0.1em 0.4em;
    border-radius: var(--radius-sm);
  }
</style>
