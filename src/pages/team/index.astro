---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';

const authEmail = Astro.request.headers.get('Cf-Access-Authenticated-User-Email');
const db = Astro.locals.runtime?.env?.OPS_DB;

let team = [];
let activity = [];
let openTodos = 0;
let activeSchedule = 0;

if (db) {
  const [teamRes, activityRes, todosRes, scheduleRes] = await Promise.all([
    db.prepare('SELECT * FROM team_members ORDER BY id ASC').all(),
    db.prepare('SELECT * FROM activity_log ORDER BY created_at DESC LIMIT 10').all(),
    db.prepare('SELECT COUNT(*) AS n FROM todos WHERE done = 0').first(),
    db.prepare(`SELECT COUNT(*) AS n FROM schedule_items
                WHERE (status_override = 'blocked')
                   OR (status_override IS NULL AND date('now') BETWEEN start_date AND end_date)`).first(),
  ]);
  team = teamRes.results;
  activity = activityRes.results;
  openTodos = todosRes?.n ?? 0;
  activeSchedule = scheduleRes?.n ?? 0;
}

const statusLabel: Record<string, string> = {
  confirmed: 'Confirmed',
  expected: 'Expected',
  unconfirmed: 'Unconfirmed',
};
const unconfirmedCount = team.filter(p => p.status === 'unconfirmed').length;

function timeAgo(iso: string) {
  const then = new Date(iso.replace(' ', 'T') + 'Z').getTime();
  const mins = Math.round((Date.now() - then) / 60000);
  if (mins < 1) return 'just now';
  if (mins < 60) return `${mins}m ago`;
  const hrs = Math.round(mins / 60);
  if (hrs < 24) return `${hrs}h ago`;
  return `${Math.round(hrs / 24)}d ago`;
}
---
<BaseLayout title="Dashboard · Between Ops" nav="internal" authEmail={authEmail}>
  <main id="main">
    <section class="team-section">
      <div class="container">
        <h1 class="team-heading">Dashboard</h1>

        <ul class="stat-row" role="list">
          <li class="stat">
            <span class="stat__n">{activeSchedule}</span>
            <span class="stat__label">in progress now</span>
          </li>
          <li class="stat">
            <span class="stat__n">{openTodos}</span>
            <span class="stat__label">open to-dos</span>
          </li>
          <li class="stat">
            <span class="stat__n">{team.length}</span>
            <span class="stat__label">people on the roster</span>
          </li>
          {unconfirmedCount > 0 && (
            <li class="stat stat--warn">
              <span class="stat__n">{unconfirmedCount}</span>
              <span class="stat__label">unconfirmed role{unconfirmedCount === 1 ? '' : 's'}</span>
            </li>
          )}
        </ul>

        <div class="dash-grid">

          <div class="dash-col">
            <h2 class="team-subheading">Roster</h2>
            <ul class="team-list" role="list" id="roster-list">
              {team.map(person => (
                <li class={`person-row person-row--${person.status}`} data-id={person.id}>
                  <div class="person-row__id">
                    <p class="person-row__name">{person.name}</p>
                    <p class="person-row__role" data-role="role-text">{person.role}</p>
                  </div>
                  <p class="person-row__remit" data-role="remit-text">{person.remit}</p>
                  <div class="person-row__meta">
                    <button class="person-row__status" type="button" data-role="cycle-status">
                      {statusLabel[person.status] ?? person.status}
                    </button>
                    <a class="person-row__email" href={`mailto:${person.email}`}>{person.email}</a>
                  </div>
                </li>
              ))}
            </ul>
            <p class="team-footnote">Click a status pill to cycle it. Confirmed → Expected → Unconfirmed.</p>
          </div>

          <div class="dash-col">
            <h2 class="team-subheading">Recent activity</h2>
            <ul class="activity-list" role="list">
              {activity.length === 0 && <li class="activity-empty">Nothing logged yet.</li>}
              {activity.map(a => (
                <li class="activity-item">
                  <p class="activity-item__line">
                    <strong>{a.actor}</strong> {a.action}{a.detail ? <>: <span class="activity-item__detail">{a.detail}</span></> : ''}
                  </p>
                  <span class="activity-item__time">{timeAgo(a.created_at)}</span>
                </li>
              ))}
            </ul>
          </div>

        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const STATUS_CYCLE = ['confirmed', 'expected', 'unconfirmed'];
  const STATUS_LABEL: Record<string, string> = { confirmed: 'Confirmed', expected: 'Expected', unconfirmed: 'Unconfirmed' };

  const listEl = document.getElementById('roster-list');
  if (listEl) {
    listEl.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('[data-role="cycle-status"]') as HTMLButtonElement | null;
      if (!btn) return;
      const li = btn.closest('li.person-row') as HTMLLIElement;
      const id = li.dataset.id;
      const current = STATUS_CYCLE.find(s => btn.textContent?.trim() === STATUS_LABEL[s]) || 'unconfirmed';
      const next = STATUS_CYCLE[(STATUS_CYCLE.indexOf(current) + 1) % STATUS_CYCLE.length];

      li.classList.add('person-row--busy');
      try {
        const res = await fetch(`/api/team/roster/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: next }),
        });
        if (!res.ok) throw new Error('Failed to update');
        li.className = `person-row person-row--${next}`;
        btn.textContent = STATUS_LABEL[next];
      } catch {
        // leave as-is; user can retry
      } finally {
        li.classList.remove('person-row--busy');
      }
    });
  }
</script>

<style>
  .team-section {
    background: var(--ink);
    padding-block: clamp(var(--space-8), 6vw, var(--space-12));
    min-height: calc(100svh - var(--nav-h));
  }

  .team-heading {
    font-family: var(--font-body);
    color: var(--paper);
    font-size: var(--text-2xl);
    margin-bottom: var(--space-6);
  }

  .team-subheading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--body);
    margin: 0 0 var(--space-3);
  }

  /* ── Stats ────────────────────────────────────────────────────────────── */
  .stat-row {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: var(--space-8);
  }
  @media (min-width: 640px) {
    .stat-row { grid-template-columns: repeat(4, 1fr); }
  }

  .stat {
    background: var(--ink-soft);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .stat__n {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--ember);
    line-height: 1;
  }
  .stat--warn .stat__n { color: var(--red); }
  .stat__label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--body);
  }

  /* ── Two-column layout ────────────────────────────────────────────────── */
  .dash-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  @media (min-width: 1000px) {
    .dash-grid {
      flex-direction: row;
      align-items: flex-start;
    }
    .dash-col:first-child { flex: 3; }
    .dash-col:last-child { flex: 2; }
  }

  /* ── Roster ───────────────────────────────────────────────────────────── */
  .team-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .person-row {
    background: var(--ink-soft);
    padding: var(--space-3) var(--space-4);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    border-left: 3px solid var(--body);
    transition: opacity 150ms var(--ease-out);
  }
  .person-row--busy { opacity: 0.5; pointer-events: none; }
  .person-row--confirmed { border-left-color: #4caf50; }
  .person-row--expected  { border-left-color: var(--ember); }
  .person-row--unconfirmed { border-left-color: var(--red); }

  @media (min-width: 800px) {
    .person-row {
      grid-template-columns: 12rem 1fr 11rem;
      align-items: center;
      gap: var(--space-4);
    }
  }

  .person-row__name {
    font-family: var(--font-body);
    font-weight: 700;
    color: var(--paper);
    font-size: var(--text-sm);
  }
  .person-row__role {
    font-size: var(--text-xs);
    color: var(--body);
    margin-top: 0.15rem;
  }

  .person-row__remit {
    font-size: var(--text-xs);
    color: var(--body);
    line-height: 1.5;
    max-width: none;
  }

  .person-row__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
  }
  @media (min-width: 800px) {
    .person-row__meta { align-items: flex-end; text-align: right; }
  }

  .person-row__status {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--body);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.15rem 0.5rem;
  }
  .person-row--confirmed .person-row__status { color: #4caf50; border-color: #4caf50; }
  .person-row--expected .person-row__status  { color: var(--ember); border-color: var(--ember); }
  .person-row--unconfirmed .person-row__status { color: var(--red); border-color: var(--red); }
  .person-row__status:hover { background: rgba(255,255,255,0.06); }
  .person-row__status:focus-visible {
    outline: 3px solid var(--ember);
    outline-offset: 1px;
  }

  .person-row__email {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--ember);
    text-decoration: none;
    word-break: break-all;
  }
  .person-row__email:hover { text-decoration: underline; }

  .team-footnote {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--body);
    margin-top: var(--space-3);
  }

  /* ── Activity feed ────────────────────────────────────────────────────── */
  .activity-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .activity-empty {
    background: var(--ink-soft);
    padding: var(--space-4);
    font-size: var(--text-sm);
    color: var(--body);
  }

  .activity-item {
    background: var(--ink-soft);
    padding: var(--space-3) var(--space-4);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .activity-item__line {
    font-size: var(--text-xs);
    color: var(--body);
    line-height: 1.5;
    max-width: none;
  }
  .activity-item__line strong { color: var(--paper); }
  .activity-item__detail { color: var(--ember); }

  .activity-item__time {
    font-size: 0.65rem;
    color: var(--body);
    white-space: nowrap;
    flex-shrink: 0;
  }
</style>
