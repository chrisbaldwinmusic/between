---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';

const authEmail = Astro.request.headers.get('Cf-Access-Authenticated-User-Email');
const db = Astro.locals.runtime?.env?.OPS_DB;

let lines = [];
let entries = [];
if (db) {
  const [linesRes, entriesRes] = await Promise.all([
    db.prepare('SELECT * FROM budget_lines ORDER BY sort ASC, id ASC').all(),
    db.prepare('SELECT * FROM budget_entries ORDER BY entry_date DESC, id DESC').all(),
  ]);
  lines = linesRes.results;
  entries = entriesRes.results;
}

const actual = (id: number) => entries.filter(e => e.line_id === id).reduce((s, e) => s + e.amount_pence, 0);
const sum = (rows: any[], f: (r: any) => number) => rows.reduce((s, r) => s + f(r), 0);
const lineById = new Map(lines.map(l => [l.id, l]));

// In-kind support appears on both sides of the ACE budget; it's tracked once, from the income side.
const spendLines = lines.filter(l => l.kind === 'expenditure' && !l.in_kind);
const incomeLines = lines.filter(l => l.kind === 'income' && !l.in_kind);
const inKindLines = lines.filter(l => l.kind === 'income' && l.in_kind);

function groupByHeading(rows: any[]) {
  const groups = new Map<string, any[]>();
  for (const r of rows) {
    if (!groups.has(r.heading)) groups.set(r.heading, []);
    groups.get(r.heading)!.push(r);
  }
  return [...groups.entries()].map(([heading, rows]) => ({
    heading,
    rows,
    budget: sum(rows, l => l.budget_pence),
    actual: sum(rows, l => actual(l.id)),
  }));
}

const spendGroups = groupByHeading(spendLines);
const spendBudget = sum(spendLines, l => l.budget_pence);
const spent = sum(spendLines, l => actual(l.id));
const left = spendBudget - spent;
const incomeBudget = sum(incomeLines, l => l.budget_pence);
const received = sum(incomeLines, l => actual(l.id));
const inKindBudget = sum(inKindLines, l => l.budget_pence);
const inKindLogged = sum(inKindLines, l => actual(l.id));
const aceGrant = incomeLines.find(l => l.heading === 'Arts Council England')?.budget_pence ?? 0;

function money(pence: number) {
  const opts = pence % 100 === 0
    ? { style: 'currency', currency: 'GBP', maximumFractionDigits: 0 }
    : { style: 'currency', currency: 'GBP' };
  return (pence / 100).toLocaleString('en-GB', opts as Intl.NumberFormatOptions);
}

function pct(part: number, whole: number) {
  return whole ? Math.round((part / whole) * 100) : 0;
}

function barWidth(part: number, whole: number) {
  return `width:${Math.max(0, Math.min(pct(part, whole), 100))}%`;
}

function fmtDate(d: string) {
  const [y, m, day] = d.split('-').map(Number);
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  return `${day} ${months[m - 1]} ${y}`;
}

// "Artist fees (average £800 per event x 10 events)" → "Artist fees"
const shortName = (l: any) => l.description.split(/ \(|: /)[0];
// …and the rest: "average £800 per event x 10 events"
function detail(l: any) {
  const rest = l.description.slice(shortName(l).length);
  if (rest.startsWith(' (') && rest.endsWith(')')) return rest.slice(2, -1);
  return rest.replace(/^:\s*/, '');
}

const today = new Date().toISOString().slice(0, 10);
const recent = entries.slice(0, 25);

const pickerGroups = [
  { label: 'Spending', rows: spendLines },
  { label: 'Income', rows: incomeLines },
  { label: 'Support in kind', rows: inKindLines },
];

const sideSections = [
  { id: 'income', title: 'Income', verb: 'received', rows: incomeLines, budget: incomeBudget, done: received },
  { id: 'inkind', title: 'Support in kind', verb: 'logged', rows: inKindLines, budget: inKindBudget, done: inKindLogged },
];
---
<BaseLayout title="Budget · Between Ops" nav="internal" authEmail={authEmail}>
  <main id="main">
    <section class="budget-section">
      <div class="container">

        <div class="page-head">
          <div>
            <h1 class="budget-heading">Budget</h1>
            <p class="budget-intro">
              Live tracker against our Arts Council England application budget
              (Supporting Grassroots Music, SGRM-00869135-R11). Chris and Dan only.
            </p>
          </div>
          <button class="btn btn-primary log-btn" type="button" data-role="open-log">+ Log an entry</button>
        </div>

        <!-- ── Overview ─────────────────────────────────────────────────── -->
        <section class="overview" aria-labelledby="h-overview">
          <h2 class="visually-hidden" id="h-overview">Overview</h2>
          <div class="overview__main">
            <p class="overview__label">Spent</p>
            <p class="overview__figure">
              <span class="overview__spent">{money(spent)}</span>
              <span class="overview__of">of {money(spendBudget)} cash budget</span>
            </p>
            <div class={`bar bar--lg${spent > spendBudget ? ' bar--over' : ''}`} aria-hidden="true">
              <span style={barWidth(spent, spendBudget)}></span>
            </div>
            <p class="overview__pct">{pct(spent, spendBudget)}% spent</p>
          </div>
          <dl class="overview__stats">
            <div class={left < 0 ? 'is-over' : ''}>
              <dt>{left < 0 ? 'Over budget' : 'Left to spend'}</dt>
              <dd>{money(Math.abs(left))}</dd>
            </div>
            <div>
              <dt>ACE grant</dt>
              <dd>{money(aceGrant)}</dd>
            </div>
            <div>
              <dt>Income received</dt>
              <dd>{money(received)} <span>of {money(incomeBudget)}</span></dd>
            </div>
            <div>
              <dt>In kind logged</dt>
              <dd>{money(inKindLogged)} <span>of {money(inKindBudget)}</span></dd>
            </div>
          </dl>
        </section>

        <!-- ── Spending ─────────────────────────────────────────────────── -->
        <section class="block" aria-labelledby="h-spend">
          <h2 class="block__title" id="h-spend">Spending</h2>

          <div class="cols-head" aria-hidden="true">
            <span>Line</span><span>Budget</span><span>Spent</span><span>Left</span><span></span>
          </div>

          {spendGroups.map(g => (
            <details class="group" open>
              <summary class="group__summary">
                <span class="group__name">{g.heading}</span>
                <span class="group__figures">
                  <span class="num"><span class="visually-hidden">Budget </span>{money(g.budget)}</span>
                  <span class="num"><span class="visually-hidden">Spent </span>{money(g.actual)}</span>
                  <span class={`num num--left${g.actual > g.budget ? ' is-over' : ''}`}>
                    <span class="visually-hidden">{g.actual > g.budget ? 'Over by ' : 'Left '}</span>{money(Math.abs(g.budget - g.actual))}
                  </span>
                </span>
                <span class={`bar group__bar${g.actual > g.budget ? ' bar--over' : ''}`} aria-hidden="true">
                  <span style={barWidth(g.actual, g.budget)}></span>
                </span>
              </summary>
              <ul class="rows" role="list">
                {g.rows.map(l => {
                  const a = actual(l.id);
                  const over = a > l.budget_pence;
                  return (
                    <li class={`row${over ? ' row--over' : ''}`}>
                      <div class="row__desc">
                        <p class="row__name">{shortName(l)}</p>
                        {detail(l) && <p class="row__detail">{detail(l)}</p>}
                        <span class={`bar row__bar${over ? ' bar--over' : ''}`} aria-hidden="true">
                          <span style={barWidth(a, l.budget_pence)}></span>
                        </span>
                      </div>
                      <span class="num row__budget"><span class="m-label">Budget </span>{money(l.budget_pence)}</span>
                      <span class="num row__actual"><span class="m-label">Spent </span>{money(a)}</span>
                      <span class={`num num--left row__left${over ? ' is-over' : ''}`}>
                        <span class="m-label">{over ? 'Over ' : 'Left '}</span>{money(Math.abs(l.budget_pence - a))}
                      </span>
                      <button class="row__log" type="button" data-role="open-log" data-line={l.id} aria-label={`Log an entry against ${shortName(l)}`}>+</button>
                    </li>
                  );
                })}
              </ul>
            </details>
          ))}
        </section>

        <!-- ── Income and in kind ───────────────────────────────────────── -->
        <div class="side-by-side">
          {sideSections.map(s => (
            <section class="block" aria-labelledby={`h-${s.id}`}>
              <h2 class="block__title" id={`h-${s.id}`}>
                {s.title}
                <span class="block__total">{money(s.done)} {s.verb} of {money(s.budget)}</span>
              </h2>
              <ul class="mini" role="list">
                {s.rows.map(l => {
                  const a = actual(l.id);
                  return (
                    <li class="mini__row">
                      <div class="mini__desc">
                        <p class="row__name">
                          {s.id === 'income' ? l.heading === 'Earned income' ? shortName(l) : l.heading : shortName(l)}
                          {l.status && <span class={`tag tag--${l.status}`}>{l.status}</span>}
                        </p>
                        <span class="bar row__bar" aria-hidden="true"><span style={barWidth(a, l.budget_pence)}></span></span>
                      </div>
                      <span class="num mini__fig">{money(a)} <span>of {money(l.budget_pence)}</span></span>
                      <button class="row__log" type="button" data-role="open-log" data-line={l.id} aria-label={`Log an entry against ${shortName(l)}`}>+</button>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
        </div>

        <!-- ── Recent entries ───────────────────────────────────────────── -->
        <section class="block" aria-labelledby="h-entries">
          <h2 class="block__title" id="h-entries">
            Recent entries
            {entries.length > recent.length && <span class="block__total">latest {recent.length} of {entries.length}</span>}
          </h2>
          {recent.length === 0 ? (
            <p class="empty">Nothing logged yet. Use <strong>+ Log an entry</strong>, or the <strong>+</strong> on any line.</p>
          ) : (
            <ul class="ledger" role="list">
              {recent.map(e => {
                const l = lineById.get(e.line_id);
                return (
                  <li class="ledger__row" data-id={e.id}>
                    <span class="ledger__date">{fmtDate(e.entry_date)}</span>
                    <span class="ledger__what">
                      {e.description}
                      <span class="ledger__line">{l ? shortName(l) : 'Unknown line'}</span>
                    </span>
                    <span class={`num ledger__amount${e.amount_pence < 0 ? ' is-neg' : ''}`}>{money(e.amount_pence)}</span>
                    <button class="ledger__delete" type="button" data-role="delete" aria-label={`Remove entry: ${e.description}, ${money(e.amount_pence)}`}>✕</button>
                  </li>
                );
              })}
            </ul>
          )}
        </section>

        <p class="budget-footnote">
          Total project cost {money(spendBudget + inKindBudget)}: {money(spendBudget)} cash plus
          {' '}{money(inKindBudget)} support in kind. Negative amounts record refunds or corrections.
        </p>
      </div>
    </section>
  </main>

  <dialog class="log-dialog" id="log-dialog" aria-labelledby="log-title">
    <form class="log-form" id="log-form" method="dialog">
      <div class="log-form__head">
        <h2 class="log-form__title" id="log-title">Log an entry</h2>
        <button class="log-form__close" type="button" data-role="close-log" aria-label="Close">✕</button>
      </div>
      <div class="field">
        <label for="entry-line">Budget line</label>
        <select id="entry-line" name="line_id" required>
          <option value="">Choose…</option>
          {pickerGroups.map(g => (
            <optgroup label={g.label}>
              {g.rows.map(l => <option value={l.id}>{g.label === 'Spending' ? `${l.heading}: ${shortName(l)}` : shortName(l)}</option>)}
            </optgroup>
          ))}
        </select>
      </div>
      <div class="field">
        <label for="entry-desc">What for</label>
        <input id="entry-desc" name="description" type="text" required autocomplete="off" />
      </div>
      <div class="field-pair">
        <div class="field">
          <label for="entry-amount">Amount (£)</label>
          <input id="entry-amount" name="amount" type="text" inputmode="decimal" required autocomplete="off" aria-describedby="amount-hint" />
        </div>
        <div class="field">
          <label for="entry-date">Date</label>
          <input id="entry-date" name="entry_date" type="date" value={today} required />
        </div>
      </div>
      <p class="field-hint" id="amount-hint">Use a minus sign for refunds or corrections, e.g. -50.</p>
      <p class="log-form__msg" id="log-msg" role="status"></p>
      <div class="log-form__actions">
        <button class="btn log-form__cancel" type="button" data-role="close-log">Cancel</button>
        <button class="btn btn-primary" type="submit">Log entry</button>
      </div>
    </form>
  </dialog>
</BaseLayout>

<script>
  const dialog = document.getElementById('log-dialog') as HTMLDialogElement;
  const form = document.getElementById('log-form') as HTMLFormElement;
  const msgEl = document.getElementById('log-msg')!;
  const lineSelect = document.getElementById('entry-line') as HTMLSelectElement;

  function showMsg(text: string) {
    msgEl.textContent = text;
  }

  async function api(path: string, options: RequestInit = {}) {
    const res = await fetch(path, {
      ...options,
      headers: { 'Content-Type': 'application/json', ...(options.headers || {}) },
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || 'Something went wrong');
    return data;
  }

  let opener: HTMLElement | null = null;

  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;

    const open = target.closest('[data-role="open-log"]') as HTMLElement | null;
    if (open) {
      opener = open;
      showMsg('');
      lineSelect.value = open.dataset.line || '';
      dialog.showModal();
      (open.dataset.line ? form.elements.namedItem('description') as HTMLElement : lineSelect).focus();
      return;
    }

    if (target.closest('[data-role="close-log"]')) {
      dialog.close();
      return;
    }

    const del = target.closest('[data-role="delete"]') as HTMLButtonElement | null;
    if (del) {
      const li = del.closest('li.ledger__row') as HTMLLIElement;
      if (!confirm('Remove this entry?')) return;
      li.classList.add('is-busy');
      try {
        await api(`/api/team/budget/${li.dataset.id}`, { method: 'DELETE' });
        location.reload();
      } catch (err: any) {
        li.classList.remove('is-busy');
        alert(err.message);
      }
    }
  });

  // Return focus to whatever opened the dialog.
  dialog.addEventListener('close', () => opener?.focus());

  // Clicking the backdrop closes the dialog.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    showMsg('');
    const fd = new FormData(form);
    const pounds = Number(String(fd.get('amount') || '').replace(/[£,\s]/g, ''));
    if (!Number.isFinite(pounds) || pounds === 0) {
      showMsg('Enter an amount in pounds, e.g. 167.16');
      return;
    }
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitBtn.disabled = true;
    try {
      await api('/api/team/budget', {
        method: 'POST',
        body: JSON.stringify({
          line_id: Number(fd.get('line_id')),
          entry_date: String(fd.get('entry_date') || ''),
          description: String(fd.get('description') || '').trim(),
          amount_pence: Math.round(pounds * 100),
        }),
      });
      location.reload();
    } catch (err: any) {
      showMsg(err.message);
      submitBtn.disabled = false;
    }
  });
</script>

<style>
  .budget-section {
    background: var(--ink);
    padding-block: clamp(var(--space-8), 6vw, var(--space-12));
    min-height: calc(100svh - var(--nav-h));
  }

  .visually-hidden {
    position: absolute !important;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .num {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* ── Page head ────────────────────────────────────────────────────────── */
  .page-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  @media (min-width: 720px) {
    .page-head {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }
  .budget-heading {
    font-family: var(--font-body);
    color: var(--paper);
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
  }
  .budget-intro {
    color: var(--body);
    font-size: var(--text-sm);
    max-width: 60ch;
  }
  .log-btn {
    flex-shrink: 0;
    align-self: flex-start;
    padding: 0.6rem 1.1rem;
    font-size: var(--text-sm);
  }
  @media (min-width: 720px) { .log-btn { align-self: auto; } }

  /* ── Bars ─────────────────────────────────────────────────────────────── */
  .bar {
    display: block;
    height: 4px;
    background: var(--line);
    border-radius: 2px;
    overflow: hidden;
  }
  .bar > span {
    display: block;
    height: 100%;
    background: var(--ember);
    border-radius: inherit;
  }
  .bar--lg { height: 10px; border-radius: 5px; }
  .bar--over > span { background: var(--red); }

  /* ── Overview ─────────────────────────────────────────────────────────── */
  .overview {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: var(--space-8);
  }
  @media (min-width: 860px) {
    .overview { grid-template-columns: 1.3fr 1fr; }
  }
  .overview__main {
    background: var(--ink-soft);
    padding: var(--space-5) var(--space-4);
  }
  .overview__label,
  .overview__stats dt,
  .block__title,
  .cols-head {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--body);
  }
  .overview__figure {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    margin: var(--space-2) 0 var(--space-3);
    max-width: none;
  }
  .overview__spent {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 8vw, 3.25rem);
    font-weight: 800;
    line-height: 1;
    color: var(--ember);
    font-variant-numeric: tabular-nums;
  }
  .overview__of {
    font-size: var(--text-sm);
    color: var(--body);
  }
  .overview__pct {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--body);
  }

  .overview__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    margin: 0;
  }
  .overview__stats > div {
    background: var(--ink-soft);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.35rem;
  }
  .overview__stats dt { font-size: 0.65rem; }
  .overview__stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--paper);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }
  .overview__stats dd span {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--body);
  }
  .overview__stats .is-over dd { color: var(--red); }

  /* ── Blocks ───────────────────────────────────────────────────────────── */
  .block { margin-bottom: var(--space-8); }
  .block__title {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
  }
  .block__total {
    text-transform: none;
    letter-spacing: 0;
    font-weight: 600;
    color: var(--ember);
  }

  /* Shared column template for headings, group summaries and rows (desktop). */
  .cols-head,
  .group__summary,
  .row {
    --cols: minmax(0, 1fr) 6.5rem 6.5rem 6.5rem 2.25rem;
  }

  .cols-head { display: none; }
  @media (min-width: 720px) {
    .cols-head {
      display: grid;
      grid-template-columns: var(--cols);
      gap: var(--space-3);
      padding: 0 var(--space-4) var(--space-2);
      font-size: 0.65rem;
    }
    .cols-head span:not(:first-child) { text-align: right; }
  }

  /* ── Spending groups ──────────────────────────────────────────────────── */
  .group {
    background: var(--ink-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    margin-bottom: var(--space-3);
    overflow: hidden;
  }
  .group__summary {
    list-style: none;
    cursor: pointer;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-2) var(--space-3);
    align-items: center;
    padding: var(--space-3) var(--space-4);
    background: rgba(255,255,255,0.03);
  }
  .group__summary::-webkit-details-marker { display: none; }
  .group__summary:focus-visible {
    outline: 3px solid var(--ember);
    outline-offset: -3px;
  }
  .group__name {
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--paper);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .group__name::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-right: 2px solid var(--body);
    border-bottom: 2px solid var(--body);
    transform: rotate(-45deg);
    flex-shrink: 0;
  }
  .group[open] .group__name::before { transform: rotate(45deg); }
  .group__figures {
    display: flex;
    gap: var(--space-3);
    font-size: var(--text-xs);
    color: var(--body);
  }
  .group__figures .num { display: none; }
  .group__figures .num--left { display: block; }
  .group__bar { grid-column: 1 / -1; }

  @media (min-width: 720px) {
    .group__summary { grid-template-columns: var(--cols); }
    .group__figures { display: contents; }
    .group__figures .num {
      display: block;
      text-align: right;
      font-size: var(--text-sm);
      font-weight: 600;
      color: var(--paper);
    }
  }

  .num--left,
  .group__figures .num--left { color: var(--ember); font-weight: 600; }
  .num--left.is-over,
  .group__figures .num--left.is-over { color: #ff8080; }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
