---
// The evaluation cadence from the ACE application, run live: per-event checklist (survey within
// 48 hours, attendance, debrief), monthly community growth, review checkpoints and live results
// from the public /feedback survey and check-in. Leads only (src/middleware.js).
export const prerender = false;

import events from '../../../data/events.json';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  HEARD_FROM, PRIOR_EVENTS, VENUE_USE, VENUE_QUESTION, LOCAL_OUTWARD, COMMUNITY_CHANNELS, label, surveyDue,
} from '../../../lib/feedback.js';
import { ukToday } from '../../../lib/dates.js';

const authEmail = Astro.request.headers.get('Cf-Access-Authenticated-User-Email');
const env = Astro.locals.runtime?.env ?? {};
const db = env.OPS_DB;

let responses: any[] = [];
let checkins: any[] = [];
let evalRows: any[] = [];
let community: any[] = [];
let reviews: any[] = [];
if (db) {
  const [r, c, e, m, s] = await Promise.all([
    db.prepare('SELECT * FROM feedback_responses ORDER BY created_at DESC').all(),
    db.prepare('SELECT * FROM checkins').all(),
    db.prepare('SELECT * FROM eval_events').all(),
    db.prepare('SELECT * FROM community_counts ORDER BY month').all(),
    db.prepare(`SELECT * FROM schedule_items WHERE task LIKE '%review%' ORDER BY start_date`).all(),
  ]);
  responses = r.results; checkins = c.results; evalRows = e.results; community = m.results; reviews = s.results;
}

// Site venue poll (KV), same question as survey Q4.
let poll = { total: 0, yes: 0 };
if (env.VENUE_KV) {
  const [yes, total] = await Promise.all([env.VENUE_KV.get('yes'), env.VENUE_KV.get('total')]);
  poll = { yes: parseInt(yes ?? '0', 10), total: parseInt(total ?? '0', 10) };
}

const today = ukToday();
const pct = (a: number, b: number) => (b ? Math.round((a / b) * 100) : 0);
const count = (rows: any[], key: string, value: string) => rows.filter(r => r[key] === value).length;

// ── Headline measures ──────────────────────────────────────────────────────
const peopleCheckedIn = checkins.reduce((s, c) => s + c.party_size, 0);
const withPostcode = [...responses, ...checkins].filter(r => r.outward_postcode);
const local = withPostcode.filter(r => LOCAL_OUTWARD.includes(r.outward_postcode)).length;
const repeat = responses.filter(r => r.prior_events !== 'first').length;
const venueYes = count(responses, 'venue_use', 'yes');

// ── Per event ──────────────────────────────────────────────────────────────
const evalBySlug = new Map(evalRows.map(r => [r.event_slug, r]));
function fmt(d: string | null) {
  if (!d) return '';
  const [y, m, day] = d.split('-').map(Number);
  return new Date(Date.UTC(y, m - 1, day)).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
}
function status(e: any, row: any) {
  if (e.date > today) return { key: 'upcoming', text: 'Upcoming' };
  const due = surveyDue(e);
  if (!row?.survey_sent_on) {
    return today > due ? { key: 'overdue', text: `Survey overdue (was due ${fmt(due)})` } : { key: 'due', text: `Send survey by ${fmt(due)}` };
  }
  if (!row.debrief_on) return { key: 'due', text: 'Debrief to do' };
  if (row.attendance == null) return { key: 'due', text: 'Add attendance' };
  return { key: 'done', text: 'Complete' };
}
const allRows = events.map(e => {
  const row = evalBySlug.get(e.slug) ?? {};
  return {
    e,
    row,
    status: status(e, row),
    responses: count(responses, 'event_slug', e.slug),
    checkedIn: checkins.filter(c => c.event_slug === e.slug).reduce((s, c) => s + c.party_size, 0),
  };
});
// Full checklist cards once an event has happened; upcoming ones get a compact list (their QR
// posters can still be printed in advance).
const eventRows = allRows.filter(r => r.e.date <= today).reverse();
const upcomingRows = allRows.filter(r => r.e.date > today);

// ── Monthly community counts, Sep 2026 to Sep 2027 ─────────────────────────
const CHANNELS = COMMUNITY_CHANNELS;
const months: string[] = [];
for (let d = new Date(Date.UTC(2026, 8, 1)); d <= new Date(Date.UTC(2027, 8, 1)); d.setUTCMonth(d.getUTCMonth() + 1)) {
  months.push(d.toISOString().slice(0, 7));
}
const communityByMonth = new Map(community.map(c => [c.month, c]));

// "Saved 20:21, 13 Oct by chris" / "Locked 13 Oct by dan" (UK time). Mirrored in the script below.
const who = (email: string | null) => (email ? email.split('@')[0] : 'someone');
const ukStamp = (sql: string, withTime = true) => new Date(sql.replace(' ', 'T') + 'Z').toLocaleString('en-GB', {
  timeZone: 'Europe/London', day: 'numeric', month: 'short', ...(withTime ? { hour: '2-digit', minute: '2-digit' } : {}),
});
function stateOf(row: any) {
  if (row?.locked_at) return { key: 'locked', text: `Locked ${ukStamp(row.locked_at, false)} by ${who(row.locked_by)}` };
  if (row?.updated_at) return { key: 'saved', text: `Saved ${ukStamp(row.updated_at)} by ${who(row.updated_by)}` };
  return { key: 'idle', text: 'Not saved yet' };
}
const monthLabel = (m: string) => new Date(`${m}-01T00:00:00Z`).toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const thisMonth = today.slice(0, 7);

// ── Breakdown helper ───────────────────────────────────────────────────────
const breakdown = (options: string[][], key: string) => {
  const rows = options.map(([v, text]) => ({ text, n: count(responses, key, v) }));
  const max = Math.max(1, ...rows.map(r => r.n));
  return rows.map(r => ({ ...r, pct: pct(r.n, responses.length), width: Math.round((r.n / max) * 100) }));
};
const wants = responses.filter(r => r.venue_wants).slice(0, 20);
const eventName = (slug: string) => events.find(e => e.slug === slug)?.name ?? slug;
---
<BaseLayout title="Evaluation · Between Ops" nav="internal" authEmail={authEmail}>
  <main id="main">
    <section class="ev-section">
      <div class="container">
        <div class="page-head">
          <div>
            <h1 class="ev-heading">Evaluation</h1>
            <p class="ev-intro">
              The evaluation plan from the ACE application, run live: a five-question survey within
              48 hours of every event, attendance at every event, a debrief after each one, monthly
              community numbers and the formal reviews. The public links live at
              {' '}<a href="/feedback">/feedback</a>, open to everyone with no PIN.
            </p>
          </div>
          <div class="head-links">
            <a class="ev-btn" href="/team/evaluation/community-report">Community growth report</a>
            <a class="ev-btn" href="/team/evaluation/survey-report">Survey report</a>
            <a class="ev-btn" href="/team/reviews">Reviews</a>
            <a class="ev-btn" href="/api/team/evaluation/export?type=survey">Survey CSV</a>
            <a class="ev-btn" href="/api/team/evaluation/export?type=checkins">Check-ins CSV</a>
            <a class="ev-btn" href="/api/team/reminders" target="_blank" rel="noopener">Preview today's emails<span class="visually-hidden"> (opens in new tab)</span></a>
            <button class="ev-btn" type="button" id="send-reminder" data-audience="leads">Send ours now</button>
            <button class="ev-btn" type="button" id="send-community" data-audience="community">Send Vikki and Emma's now</button>
            <span class="ev__msg" id="send-reminder-msg" role="status"></span>
          </div>
        </div>

        <!-- Headline measures -->
        <ul class="stat-row" role="list">
          <li class="stat">
            <span class="stat__n">{responses.length}</span>
            <span class="stat__label">survey responses</span>
          </li>
          <li class="stat">
            <span class="stat__n">{peopleCheckedIn}</span>
            <span class="stat__label">people checked in by QR</span>
          </li>
          <li class="stat">
            <span class="stat__n">{responses.length ? `${pct(venueYes, responses.length)}%` : '–'}</span>
            <span class="stat__label">say yes to a venue (survey)</span>
          </li>
          <li class="stat">
            <span class="stat__n">{poll.total ? `${pct(poll.yes, poll.total)}%` : '–'}</span>
            <span class="stat__label">say yes on the site poll ({poll.total})</span>
          </li>
          <li class="stat">
            <span class="stat__n">{withPostcode.length ? `${pct(local, withPostcode.length)}%` : '–'}</span>
            <span class="stat__label">local ({LOCAL_OUTWARD.join('/')}) of {withPostcode.length} postcodes</span>
          </li>
          <li class="stat">
            <span class="stat__n">{responses.length ? `${pct(repeat, responses.length)}%` : '–'}</span>
            <span class="stat__label">had been to a Sonic Boom Music CIC event before</span>
          </li>
        </ul>

        <!-- Per-event checklist -->
        <section class="block" aria-labelledby="h-events">
          <h2 class="block__title" id="h-events">After every event</h2>
          {eventRows.length === 0 && (
            <p class="ev-empty">Checklists appear here from the day of each event. First up: {upcomingRows[0]?.e.name}, {upcomingRows[0] && fmt(upcomingRows[0].e.date)}.</p>
          )}
          <ul class="ev-list" role="list">
            {eventRows.map(({ e, row, status, responses: n, checkedIn }) => (
              <li class={`ev ev--${status.key}`} style={`--accent:${e.accent}`}>
                <div class="ev__head">
                  <div>
                    <p class="ev__name">{e.name}</p>
                    <p class="ev__meta">{fmt(e.date)} {e.date.slice(0, 4)} · {e.venue} · {e.ticketing === 'free' ? 'Free' : 'Ticketed'}</p>
                  </div>
                  <span class={`chip chip--${status.key}`}>{status.text}</span>
                </div>

                <p class="ev__counts">
                  <strong>{n}</strong> survey response{n === 1 ? '' : 's'}
                  {e.ticketing === 'free' && <> · <strong>{checkedIn}</strong> checked in</>}
                </p>

                <form class={`ev__form${row.locked_at ? ' is-locked' : ''}`} data-event={e.slug} data-kind="event">
                  <div class="f">
                    <label for={`sent-${e.slug}`}>Survey sent</label>
                    <input id={`sent-${e.slug}`} name="survey_sent_on" type="date" value={row.survey_sent_on ?? ''} disabled={!!row.locked_at} />
                  </div>
                  <div class="f">
                    <label for={`att-${e.slug}`}>Attendance ({e.ticketing === 'free' ? 'headcount' : 'box office'})</label>
                    <input id={`att-${e.slug}`} name="attendance" type="number" min="0" inputmode="numeric" value={row.attendance ?? ''} disabled={!!row.locked_at} />
                  </div>
                  <div class="f">
                    <label for={`deb-${e.slug}`}>Debrief done</label>
                    <input id={`deb-${e.slug}`} name="debrief_on" type="date" value={row.debrief_on ?? ''} disabled={!!row.locked_at} />
                  </div>
                  <div class="f f--wide">
                    <label for={`notes-${e.slug}`}>Notes</label>
                    <input id={`notes-${e.slug}`} name="notes" type="text" value={row.notes ?? ''} disabled={!!row.locked_at} />
                  </div>
                  <div class="save-bar">
                    <button class="ev-btn ev-btn--primary" type="submit" data-role="save" hidden={!!row.locked_at}>Save<span class="visually-hidden"> {e.name}</span></button>
                    <button class="ev-btn" type="button" data-role="lock" hidden={!row.updated_at}>{row.locked_at ? 'Unlock' : 'Lock'}<span class="visually-hidden"> {e.name}</span></button>
                    <span class={`save-state save-state--${stateOf(row).key}`} role="status">{stateOf(row).text}</span>
                  </div>
                </form>

                <div class="ev__links">
                  <a href={`/team/evaluation/survey-report?e=${e.slug}`}>Survey report</a>
                  <a href={`/feedback/${e.slug}`}>Survey page</a>
                  <a href={`/team/evaluation/qr?e=${e.slug}&t=survey`}>Survey QR</a>
                  {e.ticketing === 'free' && <a href={`/feedback/${e.slug}/checkin`}>Check-in page</a>}
                  {e.ticketing === 'free' && <a href={`/team/evaluation/qr?e=${e.slug}&t=checkin`}>Check-in QR</a>}
                </div>
              </li>
            ))}
          </ul>
        </section>

        {upcomingRows.length > 0 && (
          <section class="block" aria-labelledby="h-upcoming">
            <h2 class="block__title" id="h-upcoming">Coming up <span class="block__total">print QR posters in advance</span></h2>
            <ul class="up-list" role="list">
              {upcomingRows.map(({ e }) => (
                <li style={`--accent:${e.accent}`}>
                  <span class="up-list__name">{e.name}</span>
                  <span class="up-list__date">{fmt(e.date)} {e.date.slice(0, 4)} · {e.ticketing === 'free' ? 'Free' : 'Ticketed'}</span>
                  <span class="up-list__links">
                    <a href={`/feedback/${e.slug}`}>Survey<span class="visually-hidden"> page for {e.name}</span></a>
                    <a href={`/team/evaluation/qr?e=${e.slug}&t=survey`}>Survey QR<span class="visually-hidden"> for {e.name}</span></a>
                    {e.ticketing === 'free' && <a href={`/team/evaluation/qr?e=${e.slug}&t=checkin`}>Check-in QR<span class="visually-hidden"> for {e.name}</span></a>}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <!-- Community growth -->
        <section class="block" aria-labelledby="h-community">
          <h2 class="block__title" id="h-community">
            Community growth
            <span class="block__total">monthly, reported quarterly</span>
          </h2>
          <div class="table-wrap">
            <table class="cg">
              <caption class="visually-hidden">Community members by month and channel</caption>
              <thead>
                <tr>
                  <th scope="col">Month</th>
                  {CHANNELS.map(([, text, unit]) => <th scope="col">{text}<span class="cg__unit">{unit}</span></th>)}
                  <th scope="col">Status</th>
                </tr>
              </thead>
              <tbody>
                {months.map(m => {
                  const row = communityByMonth.get(m) ?? {};
                  return (
                    <tr class={`${m === thisMonth ? 'is-now' : m > thisMonth ? 'is-future' : ''}${row.locked_at ? ' is-locked' : ''}`} data-month={m} data-kind="month">
                      <th scope="row">{monthLabel(m)}</th>
                      {CHANNELS.map(([key, text]) => (
                        <td>
                          <input
                            name={key}
                            type="number"
                            min="0"
                            inputmode="numeric"
                            value={row[key] ?? ''}
                            disabled={!!row.locked_at}
                            aria-label={`${text}, ${monthLabel(m)}`}
                          />
                        </td>
                      ))}
                      <td class="save-bar">
                        <button class="ev-btn" type="button" data-role="save" hidden={!!row.locked_at}>Save<span class="visually-hidden"> {monthLabel(m)}</span></button>
                        <button class="ev-btn" type="button" data-role="lock" hidden={!row.updated_at}>{row.locked_at ? 'Unlock' : 'Lock'}<span class="visually-hidden"> {monthLabel(m)}</span></button>
                        <span class={`save-state save-state--${stateOf(row).key}`} role="status">{stateOf(row).text}</span>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          <p class="ev-note">Save each month as you go. Lock a month once its numbers are final and reported, so they can't be changed by accident. Any lead can unlock.</p>
        </section>

        <!-- Reviews -->
        <section class="block" aria-labelledby="h-reviews">
          <h2 class="block__title" id="h-reviews">Reviews</h2>
          <ul class="reviews" role="list">
            {reviews.map(r => (
              <li class={r.end_date < today ? 'is-past' : ''}>
                <a href={`/team/reviews/${r.id}`}>{r.task}</a>
                <span>{fmt(r.start_date)} – {fmt(r.end_date)} {r.end_date.slice(0, 4)}</span>
              </li>
            ))}
          </ul>
          <p class="ev-note">Each review pulls its period together live, with space for reflections and a sign-off: see <a href="/team/reviews">Reviews</a>. Dates come from the <a href="/team/schedule">schedule</a>. The end-of-programme report is due to Arts Council England by 30 Nov 2027.</p>
        </section>

        <!-- Results -->
        <section class="block" aria-labelledby="h-results">
          <h2 class="block__title" id="h-results">
            Survey results
            <span class="block__total">{responses.length} response{responses.length === 1 ? '' : 's'}, all events</span>
          </h2>
          {responses.length === 0 ? (
            <p class="ev-empty">No responses yet. The first survey opens for Firelight on 23 Oct.</p>
          ) : (
            <div class="results">
              {[
                ['How they heard', breakdown(HEARD_FROM, 'heard_from')],
                ['Sonic Boom Music CIC events before', breakdown(PRIOR_EVENTS, 'prior_events')],
                [VENUE_QUESTION, breakdown(VENUE_USE, 'venue_use')],
              ].map(([title, rows]: any) => (
                <div class="result">
                  <h3 class="result__title">{title}</h3>
                  <ul class="bars" role="list">
                    {rows.map((r: any) => (
                      <li>
                        <span class="bars__label">{r.text}</span>
                        <span class="bars__track" aria-hidden="true"><span style={`width:${r.width}%`}></span></span>
                        <span class="bars__n">{r.n} <span>({r.pct}%)</span></span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
              <div class="result result--wide">
                <h3 class="result__title">What people want from a venue</h3>
                {wants.length === 0 ? <p class="ev-note">Nothing written yet.</p> : (
                  <ul class="quotes" role="list">
                    {wants.map(w => (
                      <li>
                        <p>{w.venue_wants}</p>
                        <span>{eventName(w.event_slug)} · {label(VENUE_USE, w.venue_use)}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          )}
        </section>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  async function post(path: string, body: unknown) {
    const res = await fetch(path, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || 'Something went wrong');
  }

  // ── Save / lock for event checklists (form[data-kind=event]) and community months (tr[data-kind=month]) ──
  const who = (email: string | null) => (email ? email.split('@')[0] : 'someone');
  const ukStamp = (sql: string, withTime = true) => new Date(sql.replace(' ', 'T') + 'Z').toLocaleString('en-GB', {
    timeZone: 'Europe/London', day: 'numeric', month: 'short', ...(withTime ? { hour: '2-digit', minute: '2-digit' } : {}),
  });

  function setState(scope: HTMLElement, key: string, text: string) {
    const el = scope.querySelector<HTMLElement>('.save-state');
    if (!el) return;
    el.className = `save-state save-state--${key}`;
    el.textContent = text;
  }

  function applyRow(scope: HTMLElement, row: any, justSaved = false) {
    const locked = Boolean(row?.locked_at);
    scope.classList.toggle('is-locked', locked);
    scope.classList.remove('is-dirty');
    scope.querySelectorAll<HTMLInputElement>('input').forEach(i => { i.disabled = locked; });
    const save = scope.querySelector<HTMLButtonElement>('[data-role="save"]');
    const lock = scope.querySelector<HTMLButtonElement>('[data-role="lock"]');
    if (save) save.hidden = locked;
    if (lock) {
      lock.hidden = !row?.updated_at;
      lock.firstChild!.textContent = locked ? 'Unlock' : 'Lock';
    }
    if (locked) setState(scope, 'locked', `Locked ${ukStamp(row.locked_at, false)} by ${who(row.locked_by)}`);
    else if (row?.updated_at) setState(scope, justSaved ? 'just-saved' : 'saved', `${justSaved ? 'Saved ✓' : 'Saved'} ${ukStamp(row.updated_at)} by ${who(row.updated_by)}`);
  }

  const endpoint = (scope: HTMLElement) =>
    scope.dataset.kind === 'event' ? '/api/team/evaluation/event' : '/api/team/evaluation/community';
  const idOf = (scope: HTMLElement) =>
    scope.dataset.kind === 'event' ? { event_slug: scope.dataset.event } : { month: scope.dataset.month };

  async function send(scope: HTMLElement, extra: Record<string, unknown>) {
    const res = await fetch(endpoint(scope), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ...idOf(scope), ...extra }),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || 'Not saved. Please try again.');
    return data.row;
  }

  async function save(scope: HTMLElement) {
    const values: Record<string, string> = {};
    scope.querySelectorAll<HTMLInputElement>('input[name]').forEach(i => { values[i.name] = i.value; });
    const btn = scope.querySelector<HTMLButtonElement>('[data-role="save"]');
    if (btn) btn.disabled = true;
    setState(scope, 'busy', 'Saving…');
    try {
      applyRow(scope, await send(scope, values), true);
    } catch (err: any) {
      setState(scope, 'error', err.message);
    } finally {
      if (btn) btn.disabled = false;
    }
  }

  // Unsaved changes are flagged on the row/card, and leaving the page asks first.
  document.addEventListener('input', (e) => {
    const scope = (e.target as HTMLElement).closest<HTMLElement>('[data-kind]');
    if (!scope || scope.classList.contains('is-locked')) return;
    scope.classList.add('is-dirty');
    setState(scope, 'dirty', 'Unsaved changes');
  });
  window.addEventListener('beforeunload', (e) => {
    if (document.querySelector('[data-kind].is-dirty')) e.preventDefault();
  });

  document.querySelectorAll<HTMLFormElement>('form[data-kind="event"]').forEach(form => {
    form.addEventListener('submit', (e) => { e.preventDefault(); save(form); });
  });

  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-role="save"], [data-role="lock"]');
    const scope = btn?.closest<HTMLElement>('[data-kind]');
    if (!btn || !scope) return;
    if (btn.dataset.role === 'save') {
      if (scope.dataset.kind === 'month') save(scope); // event forms save via submit
      return;
    }
    // Lock / unlock
    const locking = !scope.classList.contains('is-locked');
    if (locking && scope.classList.contains('is-dirty')) {
      setState(scope, 'error', 'Save your changes before locking.');
      return;
    }
    btn.disabled = true;
    try {
      applyRow(scope, await send(scope, { lock: locking }));
    } catch (err: any) {
      setState(scope, 'error', err.message);
    } finally {
      btn.disabled = false;
    }
  });

  document.querySelectorAll<HTMLButtonElement>('#send-reminder, #send-community').forEach(btn => {
    btn.addEventListener('click', async () => {
      const msg = document.getElementById('send-reminder-msg')!;
      const audience = btn.dataset.audience;
      if (audience === 'community' && !confirm("Send today's community email to Vikki and Emma now?")) return;
      btn.disabled = true;
      msg.textContent = 'Sending…';
      try {
        const res = await fetch(`/api/team/reminders?audience=${audience}`, { method: 'POST' });
        const data = await res.json().catch(() => ({}));
        msg.textContent = res.ok ? `Sent ✓ "${data.subject}" to ${(data.to || []).join(', ')}` : (data.error || 'Not sent');
      } catch {
        msg.textContent = 'Not sent';
      } finally {
        btn.disabled = false;
      }
    });
  });

</script>

<style>
  .ev-section {
    background: var(--ink);
