  .sc-chip strong { color: var(--paper); }
  .sc-warn { color: #ff9a9a; }
  .sc-layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4); align-items: start; }
  @media (min-width: 960px) { .sc-layout { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); } }
  .sc-side { display: grid; gap: var(--space-4); min-width: 0; }
  .sc-card { background: var(--ink-soft); border: 1px solid var(--line); border-radius: 8px; padding: var(--space-4); color: var(--body); font-size: var(--text-sm); min-width: 0; }
  .sc-h2 { font-family: var(--font-body); font-size: var(--text-sm); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--paper); margin: 0 0 var(--space-3); }
  .sc-field { margin: 0 0 var(--space-4); padding: 0; border: 0; min-width: 0; }
  .sc-card label, .sc-label { display: block; color: var(--paper); margin: 0 0 var(--space-1); padding: 0; }
  .sc-card input[type=url], .sc-card input[type=datetime-local], .sc-card textarea { width: 100%; max-width: 100%; box-sizing: border-box; background: var(--ink); color: var(--paper); border: 1px solid var(--line); border-radius: 6px; padding: 0.6rem; font: inherit; }
  .sc-card input:disabled { opacity: 0.5; }
  .sc-card input:focus-visible, .sc-card textarea:focus-visible, .sc-btn:focus-visible, .sc-tab:focus-visible, .sc-card:focus-visible, .sc-preview:focus-visible, summary:focus-visible, .sc-visually-hidden:focus-visible + * { outline: 3px solid var(--ember); outline-offset: 2px; }
  .sc-visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .sc-visually-hidden:focus-visible ~ .sc-pick, .sc-photo:focus-within .sc-pick { outline: 3px solid var(--ember); outline-offset: 2px; }
  .sc-photo { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; position: relative; }
  .sc-pick { display: inline-flex; align-items: center; margin: 0; }
  .sc-thumbwrap { display: flex; align-items: center; gap: var(--space-2); margin: 0; }
  .sc-thumbwrap img, .sc-thumb { border-radius: 6px; max-width: 120px; height: auto; display: block; }
  .sc-media { list-style: none; margin: 0 0 var(--space-3); padding: 0; display: grid; gap: var(--space-3); }
  .sc-media:empty { display: none; }
  .sc-mitem { display: flex; gap: var(--space-3); align-items: flex-start; border: 1px solid var(--line); border-radius: 8px; padding: var(--space-3); min-width: 0; }
  .sc-mitem__body { flex: 1; min-width: 0; }
  .sc-mitem .sc-actions { margin-top: var(--space-1); }
  .sc-mitem .sc-btn--small { margin: 0; }
  .sc-pick.is-disabled { opacity: 0.6; cursor: not-allowed; }
  .sc-url { margin-top: var(--space-2); }
  .sc-url input { margin-top: var(--space-1); }
  .sc-more { margin-bottom: var(--space-4); }
  .sc-more[open] summary { margin-bottom: var(--space-3); }
  .sc-hint { color: var(--body); margin: var(--space-1) 0 0; }
  .sc-where { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); }
  .sc-where legend { width: 100%; }
  .sc-where .sc-hint { width: 100%; margin: 0; }
  .sc-where .sc-hint:empty { display: none; }
  .sc-card label.sc-check { display: flex; gap: var(--space-2); align-items: flex-start; margin: var(--space-3) 0 0; cursor: pointer; }
  .sc-where label.sc-check { margin: 0; align-items: center; }
  .sc-check input { flex: none; width: 22px; height: 22px; margin: 0; accent-color: var(--red); }
  .sc-actions { display: flex; gap: var(--space-2); margin-top: var(--space-3); flex-wrap: wrap; }
  .sc-btn { display: inline-block; background: var(--paper); color: var(--ink); border: 0; border-radius: 6px; padding: 0.65rem 1rem; font: inherit; font-weight: 700; cursor: pointer; min-height: 44px; text-decoration: none; box-sizing: border-box; }
  .sc-card a.sc-btn { color: var(--ink); }
  .sc-card a.sc-btn--ghost, .sc-btn--ghost { background: transparent; color: var(--paper); border: 1px solid var(--line); }
  .sc-btn--go { background: var(--red); color: #fff; }
  .sc-btn--small { min-height: 36px; padding: 0.35rem 0.75rem; margin: var(--space-2) var(--space-2) 0 0; }
  .sc-btn:disabled { opacity: 0.6; cursor: progress; }
  .sc-preview { margin-top: var(--space-4); border-top: 1px solid var(--line); padding-top: var(--space-3); }
  .sc-preview__lead { color: var(--paper); font-weight: 700; margin: 0 0 var(--space-2); }
  .sc-dl { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: var(--space-1) var(--space-3); margin: 0; }
  .sc-dl dt { color: var(--body); }
  .sc-dl dd { margin: 0; color: var(--paper); white-space: pre-wrap; overflow-wrap: anywhere; }
  .sc-tabs { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-3); }
  .sc-views { margin: var(--space-4) 0 var(--space-5); align-items: center; }
  .sc-pref { margin-left: auto; display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--text-xs); color: var(--body); }
  .sc-pref select { font: inherit; font-size: var(--text-sm); color: var(--paper); background: var(--ink); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 0.4rem 0.5rem; min-height: 40px; }
  .sc-pref select:focus-visible { outline: 3px solid var(--ember); outline-offset: 2px; }
  .sc-badge { display: inline-block; min-width: 1.4em; padding: 0 0.4em; margin-left: 0.3em; border-radius: 999px; background: var(--red); color: #fff; font-size: 0.75rem; font-weight: 700; text-align: center; }
  .sc-tab { background: transparent; color: var(--paper); border: 1px solid var(--line); border-radius: 999px; padding: 0.4rem 1rem; font: inherit; min-height: 40px; cursor: pointer; }
  .sc-tab[aria-pressed=true] { background: var(--paper); color: var(--ink); font-weight: 700; }
  .sc-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  .sc-item { display: flex; gap: var(--space-3); border-left: 3px solid var(--line); padding-left: var(--space-3); min-width: 0; }
  .sc-item__body { min-width: 0; }
  .sc-item p { margin: 0 0 var(--space-1); color: var(--paper); overflow-wrap: anywhere; }
  .sc-item p.sc-muted, .sc-muted { color: var(--body); }
  .sc-pic { flex: none; border-radius: 6px; object-fit: cover; }
  .sc-reply { margin-top: var(--space-2); }
  @media (prefers-reduced-motion: no-preference) { .sc-btn, .sc-tab { transition: background-color 0.15s; } }
</style>
