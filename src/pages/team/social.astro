---
// Facebook Page + Instagram for Chris, Dan, Vikki and Emma (src/lib/team-access.js). One composer
// posts to either or both; everything goes through /api/team/social, which validates first, only
// sends on an explicit confirm, and logs each send. Remote text is only ever inserted with textContent.
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import CommentsInbox from '../../components/CommentsInbox.astro';
const authEmail = Astro.request.headers.get('Cf-Access-Authenticated-User-Email');
---
<BaseLayout title="Social · Between Ops" nav="internal" authEmail={authEmail}>
  <main id="main">
    <section class="sc-section">
      <div class="container">
        <div class="sc-top">
          <h1 class="sc-heading">Social</h1>
          <p id="sc-status" class="sc-pill" role="status" aria-live="polite">Loading…</p>
        </div>
        <p class="sc-intro">Posts, carousels, Stories and Reels for the Facebook Page and Instagram account of Sonic Boom Music CIC. Nothing is sent until you press <strong>Confirm and send</strong>.</p>

        <details class="sc-rules">
          <summary>Posting rules</summary>
          <ul>
            <li>Lead with people and their stories. Only share a story marked "OK for social media" (<a href="/team/stories">Stories</a>).</li>
            <li>Write Sonic Boom Music CIC in full. The permanent venue is our ambition: never say it is confirmed.</li>
            <li>Every link needs UTM tags (<code>utm_source</code>, <code>utm_medium</code>, <code>utm_campaign</code>).</li>
            <li>Every image needs alt text, and anyone you can recognise needs photo consent (<a href="/team/consents">Consents</a>). Videos need a description, video consent and captions for anything spoken.</li>
          </ul>
        </details>

        <div class="sc-tabs sc-views" role="group" aria-label="Social views">
          <button type="button" class="sc-tab" id="view-posts" aria-pressed="true">Posts</button>
          <button type="button" class="sc-tab" id="view-comments" aria-pressed="false">Comments <span id="view-comments-n" class="sc-badge" hidden></span></button>
          <span class="sc-pref">
            <label for="view-pref">Open on</label>
            <select id="view-pref">
              <option value="auto">Most pressing</option>
              <option value="posts">Posts</option>
              <option value="comments">Comments</option>
            </select>
          </span>
        </div>

        <div id="sc-view-posts">
        <div id="sc-accounts" class="sc-accounts"></div>

        <div class="sc-layout">
          <form id="composer" class="sc-card" novalidate>
            <h2 class="sc-h2">New post</h2>

            <fieldset class="sc-field sc-where">
              <legend class="sc-label">What are you making?</legend>
              <label class="sc-check" for="fmt-post"><input id="fmt-post" type="radio" name="format" value="post" checked><span>Post</span></label>
              <label class="sc-check" for="fmt-carousel"><input id="fmt-carousel" type="radio" name="format" value="carousel"><span>Carousel</span></label>
              <label class="sc-check" for="fmt-story"><input id="fmt-story" type="radio" name="format" value="story"><span>Story</span></label>
              <label class="sc-check" for="fmt-reel"><input id="fmt-reel" type="radio" name="format" value="reel"><span>Reel</span></label>
              <p id="format-hint" class="sc-hint"></p>
            </fieldset>

            <div class="sc-field">
              <span class="sc-label" id="media-label">Photo</span>
              <ul id="media-list" class="sc-media" role="list" aria-labelledby="media-label"></ul>
              <div class="sc-photo">
                <label class="sc-btn sc-btn--ghost sc-pick" for="media-file" id="media-pick">Add a photo</label>
                <input id="media-file" class="sc-visually-hidden" type="file" accept="image/*" aria-describedby="media-hint">
              </div>
              <p id="media-hint" class="sc-hint"></p>
              <details class="sc-url">
                <summary>Use a media URL instead</summary>
                <label for="media-url">Public https link to a JPEG, MP4 or MOV</label>
                <input id="media-url" type="url" inputmode="url" placeholder="https://…">
                <button type="button" class="sc-btn sc-btn--small sc-btn--ghost" id="media-url-add">Add this URL</button>
              </details>
            </div>

            <div class="sc-field" id="consent-field" hidden>
              <label class="sc-check" for="consent"><input id="consent" type="checkbox"><span id="consent-text"></span></label>
              <label class="sc-check" for="captions" id="captions-wrap"><input id="captions" type="checkbox"><span>Anything spoken or sung in the video is captioned on screen, or nothing is spoken.</span></label>
            </div>

            <div class="sc-field">
              <label for="text" id="text-label">Message</label>
              <textarea id="text" rows="6" maxlength="5000" aria-describedby="count"></textarea>
              <p id="count" class="sc-hint" aria-live="off"></p>
            </div>

            <fieldset class="sc-field sc-where">
              <legend class="sc-label">Post to</legend>
              <label class="sc-check" for="to-fb"><input id="to-fb" type="checkbox" checked><span>Facebook</span></label>
              <label class="sc-check" for="to-ig"><input id="to-ig" type="checkbox"><span>Instagram</span></label>
              <p id="where-hint" class="sc-hint"></p>
            </fieldset>

            <details class="sc-more" id="fb-options">
              <summary>Facebook options: link, schedule</summary>
              <div class="sc-field">
                <label for="link">Link (with UTM tags)</label>
                <input id="link" type="url" inputmode="url" placeholder="https://between.sonicboom.org.uk/?utm_source=facebook&utm_medium=social&utm_campaign=…">
                <p id="link-hint" class="sc-hint">Only plain text posts carry a separate link. Otherwise put it, with UTM tags, in the message.</p>
              </div>
              <div class="sc-field">
                <label for="when">Schedule for (leave empty to post now)</label>
                <input id="when" type="datetime-local">
                <p id="when-hint" class="sc-hint">Scheduling is Facebook only, for posts and carousels, at least 10 minutes ahead.</p>
              </div>
            </details>

            <div class="sc-actions"><button type="submit" class="sc-btn" id="preview-btn">Preview</button></div>
            <div class="sc-preview" id="preview" hidden tabindex="-1"></div>
          </form>

          <div class="sc-side">
            <div class="sc-card">
              <div class="sc-tabs" role="group" aria-label="Recent posts">
                <button type="button" class="sc-tab" id="tab-fb" aria-pressed="true">Facebook</button>
                <button type="button" class="sc-tab" id="tab-ig" aria-pressed="false">Instagram</button>
                <button type="button" class="sc-tab" id="sc-refresh">Refresh</button>
              </div>
              <ul id="fb-list" class="sc-list" role="list"></ul>
              <ul id="ig-list" class="sc-list" role="list" hidden></ul>
            </div>
            <div class="sc-card" id="sc-comments" hidden tabindex="-1">
              <div class="sc-top">
                <h2 class="sc-h2" id="sc-comments-title">Comments on this post (live)</h2>
                <button type="button" class="sc-btn sc-btn--small sc-btn--ghost" id="sc-comments-refresh">Refresh</button>
              </div>
              <ul id="sc-comments-list" class="sc-list" role="list"></ul>
            </div>
          </div>
        </div>
        </div>

        <div id="sc-view-comments" hidden>
          <CommentsInbox />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const API = '/api/team/social';
  const $ = (s: string, el: ParentNode = document) => el.querySelector(s) as HTMLElement;
  const inp = (s: string) => $(s) as HTMLInputElement;
  const ta = (s: string) => $(s) as HTMLTextAreaElement;
  const statusEl = $('#sc-status');
  const say = (msg: string, ok = false) => { statusEl.textContent = msg; statusEl.classList.toggle('is-ok', ok); };

  async function api(view: string, extra = ''): Promise<any> {
    const r = await fetch(`${API}?view=${view}${extra}`);
    const d = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(d.error || 'Something went wrong.');
    return d;
  }
  async function send(body: object): Promise<any> {
    const r = await fetch(API, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(d.error || 'Something went wrong.');
    return d;
  }
  function el(tag: string, text = '', cls = '') {
    const e = document.createElement(tag);
    if (text) e.textContent = text;
    if (cls) e.className = cls;
    return e;
  }
  const when = (iso?: string) => (iso ? new Date(iso).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : '');
  const clip = (s = '', n = 140) => (s.length > n ? s.slice(0, n) + '…' : s);
  const safeImg = (u?: string) => (typeof u === 'string' && /^https:\/\//.test(u) ? u : '');

  // ── Composer ──────────────────────────────────────────────────────────────
  type Item = { kind: 'image' | 'video'; url: string; thumb: string; alt: string; ratio: number; seconds: number };
  type Format = 'post' | 'carousel' | 'story' | 'reel';
  const RULES: Record<Format, { min: number; max: number; kinds: string[]; accept: string; noun: string; hint: string; media: string }> = {
    post: { min: 0, max: 1, kinds: ['image'], accept: 'image/*', noun: 'a photo', media: 'Photo (optional for Facebook, needed for Instagram)', hint: 'One post to your feed.' },
    carousel: { min: 2, max: 10, kinds: ['image'], accept: 'image/*', noun: 'photos', media: 'Photos (2 to 10, shown in this order)', hint: 'Swipeable photos. Instagram calls it a carousel; Facebook shows it as a multi-photo post.' },
    story: { min: 1, max: 1, kinds: ['image', 'video'], accept: 'image/*,video/mp4,video/quicktime', noun: 'a photo or video', media: 'Photo or video (portrait 9:16 is best)', hint: 'Disappears after 24 hours. Stories have no caption and Instagram takes no alt text for them, so put any words on screen, big and clear.' },
    reel: { min: 1, max: 1, kinds: ['video'], accept: 'video/mp4,video/quicktime', noun: 'a video', media: 'Video, 3 to 90 seconds (portrait 9:16 is best)', hint: 'Short vertical video. Export as MP4 (H.264) with location turned off: unlike photos, video is not scrubbed here.' },
  };
  const MAX_VIDEO = 90 * 1024 * 1024;
  let items: Item[] = [];
  let busy = false;
  const format = (): Format => (document.querySelector('input[name=format]:checked') as HTMLInputElement).value as Format;
  const hasVideo = () => items.some(i => i.kind === 'video');

  function renderMedia() {
    const ul = $('#media-list');
    ul.replaceChildren();
    items.forEach((it, i) => {
      const li = el('li', '', 'sc-mitem');
      const label = it.kind === 'video' ? 'video' : `photo ${items.length > 1 ? i + 1 : ''}`.trim();
      if (it.kind === 'video') {
        const v = document.createElement('video');
        v.src = it.thumb; v.controls = true; v.muted = true; v.playsInline = true; v.preload = 'metadata'; v.width = 96; v.className = 'sc-thumb';
        v.setAttribute('aria-label', `Preview of the ${label}`);
        li.append(v);
      } else {
        const img = document.createElement('img');
        img.src = it.thumb; img.alt = `Preview of ${label}`; img.width = 96; img.className = 'sc-thumb';
        li.append(img);
      }
      const body = el('div', '', 'sc-mitem__body');
      const id = `alt-${i}`;
      const lab = el('label', it.kind === 'video' ? 'Describe the video: what happens, who is in it' : `Alt text: describe ${label} for people who can't see it`);
      lab.setAttribute('for', id);
      const t = el('textarea') as HTMLTextAreaElement;
      t.id = id; t.rows = 2; t.maxLength = 1000; t.value = it.alt;
      t.addEventListener('input', () => { it.alt = t.value; });
      body.append(lab, t);
      if (RULES[format()].kinds.includes('image') && it.kind === 'image' && it.ratio && format() !== 'post' && format() !== 'carousel' && (it.ratio < 0.5 || it.ratio > 0.62)) {
        body.append(el('p', 'Not portrait 9:16: it will have bars or be cropped.', 'sc-hint'));
      }
      if (it.kind === 'video' && it.ratio && (it.ratio < 0.5 || it.ratio > 0.62)) body.append(el('p', 'Not portrait 9:16: it will have bars or be cropped.', 'sc-hint'));
      const row = el('div', '', 'sc-actions');
      const rm = el('button', 'Remove', 'sc-btn sc-btn--small sc-btn--ghost') as HTMLButtonElement; rm.type = 'button';
      rm.setAttribute('aria-label', `Remove ${label}`);
      rm.onclick = () => { items.splice(i, 1); renderMedia(); sync(); ($('#media-pick') as HTMLElement).focus(); };
      row.append(rm);
      if (items.length > 1) {
        const move = (d: number, text: string) => {
          const b = el('button', text, 'sc-btn sc-btn--small sc-btn--ghost') as HTMLButtonElement; b.type = 'button';
          b.disabled = i + d < 0 || i + d >= items.length;
          b.setAttribute('aria-label', `${text}: ${label}`);
          b.onclick = () => { [items[i], items[i + d]] = [items[i + d], items[i]]; renderMedia(); sync(); (ul.children[i + d]?.querySelector(`[aria-label="${text}: ${label.replace(/\d+/, String(i + d + 1))}"]`) as HTMLElement | null)?.focus(); };
          row.append(b);
        };
        move(-1, 'Move earlier'); move(1, 'Move later');
      }
      body.append(row);
      li.append(body);
      ul.append(li);
    });
  }

  function sync() {
    const f = format(), rule = RULES[f];
    const scheduled = !!inp('#when').value;
    const full = items.length >= rule.max;
    $('#format-hint').textContent = rule.hint;
    $('#media-label').textContent = rule.media;
    $('#media-pick').textContent = full ? (rule.max === 1 ? 'Remove it to choose another' : 'Ten photos is the most') : items.length ? 'Add another' : `Add ${rule.noun}`;
    (inp('#media-file')).disabled = full || busy;
    $('#media-pick').classList.toggle('is-disabled', full || busy);
    inp('#media-file').accept = rule.accept;
    inp('#media-file').multiple = rule.max > 1;
    $('#media-hint').textContent = f === 'carousel' || f === 'post'
      ? 'Resized and saved as a JPEG here, which also removes location data.'
      : f === 'story' ? 'Photos are resized and saved as JPEGs here. Videos can be up to 60 seconds and 90 MB.' : 'MP4 or MOV, up to 90 MB.';
    // Consent applies once there is any media.
    $('#consent-field').hidden = !items.length;
    $('#consent-text').textContent = hasVideo()
      ? 'Anyone recognisable or audible in this video has given video consent (see Consents), or nobody is recognisable.'
      : items.length > 1 ? 'Anyone recognisable in these photos has given photo consent, or nobody is recognisable.' : 'Anyone recognisable in this photo has given photo consent, or nobody is recognisable.';
    $('#captions-wrap').hidden = !hasVideo();
    // Instagram needs the media the format asks for, and can't be scheduled from here.
    const ig = inp('#to-ig');
    const igReady = items.length >= Math.max(1, rule.min) && !scheduled;
    ig.disabled = !igReady;
    if (ig.disabled) ig.checked = false;
    $('#where-hint').textContent = items.length < Math.max(1, rule.min) ? `Instagram needs ${rule.noun}.` : scheduled ? 'Scheduled posts go to Facebook only. Instagram posts publish straight away.' : '';
    // Message / caption.
    const noText = f === 'story';
    ta('#text').disabled = noText;
    if (noText) ta('#text').value = '';
    $('#text-label').textContent = noText ? 'Caption (Stories have none)' : f === 'reel' || (ig.checked && !inp('#to-fb').checked) ? 'Caption' : 'Message';
    const limit = ig.checked || f === 'reel' ? 2200 : 5000;
    ta('#text').maxLength = limit;
    $('#count').textContent = noText ? '' : `${ta('#text').value.length} of ${limit} characters${limit === 2200 ? ' (Instagram and Reel limit)' : ''}`;
    // Facebook options.
    const link = inp('#link');
    link.disabled = f !== 'post' || items.length > 0;
    if (link.disabled) link.value = '';
    $('#link-hint').hidden = !link.disabled;
    const canSchedule = f === 'post' || f === 'carousel';
    inp('#when').disabled = !canSchedule;
    if (!canSchedule) inp('#when').value = '';
    $('#when-hint').textContent = canSchedule ? 'Scheduling is Facebook only, for posts and carousels, at least 10 minutes ahead.' : 'Stories and Reels can\'t be scheduled from here.';
  }
  ['#text', '#to-ig', '#to-fb', '#when'].forEach(s => $(s).addEventListener('input', sync));
  $('#to-ig').addEventListener('change', sync);
  document.querySelectorAll('input[name=format]').forEach(r => r.addEventListener('change', () => {
    const rule = RULES[format()];
    const keep = items.filter(i => rule.kinds.includes(i.kind)).slice(0, rule.max);
    if (keep.length < items.length) say(`Some media didn't fit a ${format()} and was removed.`);
    items = keep;
    renderMedia(); sync();
  }));

  // Photos: resize to at most 1440px on the long side and re-encode as JPEG. Re-encoding drops location
  // and camera data (EXIF), which matters for photos of people. Then upload to our own storage; Meta
  // fetches it from the public /social-media/ URL.
  async function toJpeg(file: File): Promise<{ blob: Blob; w: number; h: number }> {
    const bmp = await createImageBitmap(file);
    const k = Math.min(1, 1440 / Math.max(bmp.width, bmp.height));
    const w = Math.round(bmp.width * k), h = Math.round(bmp.height * k);
    const c = document.createElement('canvas'); c.width = w; c.height = h;
    const ctx = c.getContext('2d')!; ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, w, h); ctx.drawImage(bmp, 0, 0, w, h);
    const blob: Blob | null = await new Promise(r => c.toBlob(r, 'image/jpeg', 0.88));
    if (!blob) throw new Error('Could not read that image.');
    return { blob, w, h };
  }
  function videoInfo(file: File): Promise<{ seconds: number; ratio: number; src: string }> {
    return new Promise((resolve, reject) => {
      const src = URL.createObjectURL(file);
      const v = document.createElement('video');
      v.preload = 'metadata';
      v.onloadedmetadata = () => resolve({ seconds: v.duration, ratio: v.videoWidth / v.videoHeight, src });
      v.onerror = () => { URL.revokeObjectURL(src); reject(new Error('Could not read that video. Use an MP4 (H.264) or MOV.')); };
      v.src = src;
    });
  }
  async function addPhoto(file: File) {
    const { blob, w, h } = await toJpeg(file);
    const fd = new FormData(); fd.append('file', blob, 'image.jpg');
    const r = await fetch('/api/team/social-media', { method: 'POST', body: fd });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(d.error || 'Upload failed.');
    items.push({ kind: 'image', url: d.url, thumb: URL.createObjectURL(blob), alt: '', ratio: w / h, seconds: 0 });
  }
  async function addVideo(file: File) {
    const f = format();
    if (file.type !== 'video/mp4' && file.type !== 'video/quicktime') throw new Error('Use an MP4 or MOV video.');
    if (file.size > MAX_VIDEO) throw new Error('That video is over 90 MB. Export it smaller and try again.');
    const info = await videoInfo(file);
    const [lo, hi] = f === 'reel' ? [3, 90] : [1, 60];
    if (info.seconds < lo || info.seconds > hi) { URL.revokeObjectURL(info.src); throw new Error(`${f === 'reel' ? 'Reels' : 'Story videos'} must be ${lo === 1 ? 'up to' : lo + ' to'} ${hi} seconds. This one is ${Math.round(info.seconds)}.`); }
    say('Uploading the video. Keep this page open…');
    const r = await fetch('/api/team/social-video', { method: 'POST', headers: { 'Content-Type': file.type }, body: file });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) { URL.revokeObjectURL(info.src); throw new Error(d.error || 'Upload failed.'); }
    items.push({ kind: 'video', url: d.url, thumb: info.src, alt: '', ratio: info.ratio, seconds: info.seconds });
  }
  inp('#media-file').addEventListener('change', async () => {
    const files = Array.from(inp('#media-file').files ?? []);
    inp('#media-file').value = '';
    if (!files.length) return;
    busy = true; sync();
    try {
      const rule = RULES[format()];
      for (const file of files) {
        if (items.length >= rule.max) { say(`That's the most a ${format()} can hold.`); break; }
        const isVideo = file.type.startsWith('video/');
        if (!rule.kinds.includes(isVideo ? 'video' : 'image')) throw new Error(`A ${format()} takes ${rule.noun}.`);
        say(isVideo ? 'Reading the video…' : 'Preparing and uploading the photo…');
        await (isVideo ? addVideo(file) : addPhoto(file));
      }
      renderMedia();
      say(`Added. Describe ${items.length > 1 ? 'each one' : 'it'} and tick the consent box.`, true);
      (document.getElementById(`alt-${items.length - 1}`) as HTMLElement | null)?.focus();
    } catch (err: any) { say(err.message); }
    finally { busy = false; renderMedia(); sync(); }
  });
  $('#media-url-add').addEventListener('click', () => {
    const u = inp('#media-url').value.trim();
    const rule = RULES[format()];
    if (!/^https:\/\//.test(u)) { say('Use a public https link.'); return; }
    const kind = /\.(mp4|mov)(\?|$)/i.test(u) ? 'video' : 'image';
    if (!rule.kinds.includes(kind)) { say(`A ${format()} takes ${rule.noun}.`); return; }
    if (items.length >= rule.max) { say(`That's the most a ${format()} can hold.`); return; }
    items.push({ kind, url: u, thumb: u, alt: '', ratio: 0, seconds: 0 });
    inp('#media-url').value = '';
    renderMedia(); sync();
  });

  function build() {
    const f = format(), rule = RULES[f];
    const message = ta('#text').value.trim();
    const toFb = inp('#to-fb').checked, toIg = inp('#to-ig').checked;
    if (!toFb && !toIg) { say('Choose Facebook, Instagram or both.'); return null; }
    if (items.length < rule.min || items.length > rule.max) { say(`A ${f} needs ${rule.noun}${rule.min > 1 ? ` (${rule.min} to ${rule.max})` : ''}.`); return null; }
    if (f !== 'story' && f !== 'reel' && !message && !toIg) { say('Write a message first.'); return null; }
    if (f === 'carousel' && !message && toFb) { say('Write a message for the Facebook post.'); return null; }
    for (let i = 0; i < items.length; i++) {
      if (!items[i].alt.trim()) { say(items[i].kind === 'video' ? 'Describe the video.' : `Add alt text for photo ${i + 1}.`); document.getElementById(`alt-${i}`)?.focus(); return null; }
    }
    if (items.length && !inp('#consent').checked) { say(`Tick the ${hasVideo() ? 'video' : 'photo'} consent box first.`); inp('#consent').focus(); return null; }
    if (hasVideo() && !inp('#captions').checked) { say('Confirm the video is captioned, or has nothing spoken.'); inp('#captions').focus(); return null; }
    if (toIg && (f === 'post' || f === 'carousel') && items.some(i => i.ratio && (i.ratio < 0.8 || i.ratio > 1.91))) { say('Instagram needs photos between 4:5 (portrait) and 1.91:1 (landscape). Crop and add them again.'); return null; }
    const w = inp('#when').value;
    const link = inp('#link').value.trim();
    const first = items[0];
    const media: any = f === 'carousel'
      ? { images: items.map(i => ({ url: i.url, alt: i.alt.trim() })), consent_ok: true }
      : !first ? {}
      : first.kind === 'video'
        ? { video_url: first.url, alt_text: first.alt.trim(), consent_ok: true, captions_ok: true }
        : { image_url: first.url, alt_text: first.alt.trim(), consent_ok: true };
    const posts: { platform: string; body: any }[] = [];
    if (toFb) posts.push({ platform: 'Facebook', body: { action: 'publish_facebook', format: f, message, ...media, ...(link && f === 'post' && !first ? { link } : {}), ...(w ? { schedule_at: new Date(w).toISOString() } : {}) } });
    if (toIg) posts.push({ platform: 'Instagram', body: { action: 'publish_instagram', format: f, caption: message, ...media } });
    return { posts, message, f, when: w, link };
  }

  // Instagram may still be processing a video after the first call: ask again with the creation id.
  async function sendConfirmed(body: any) {
    let r = await send({ ...body, confirm: true });
    for (let i = 0; r.pending && i < 6; i++) {
      say('Instagram is processing the video. Keep this page open…');
      r = await send({ action: 'finish_instagram', creation_id: r.creation_id, confirm: true });
    }
    if (r.pending) throw new Error(`Instagram is still processing the video and has not published it (creation id ${r.creation_id}). Ask Chris to finish it.`);
    return r;
  }

  $('#composer').addEventListener('submit', async e => {
    e.preventDefault();
    const b = build();
    if (!b) return;
    const box = $('#preview');
    box.hidden = true;
    const btn = $('#preview-btn') as HTMLButtonElement;
    btn.disabled = true;
    try {
      // Dry run each destination first: this validates (UTMs, alt text, schedule time) and sends nothing.
      for (const p of b.posts) await send({ ...p.body, confirm: false });
      box.replaceChildren(el('p', 'Check this before it goes out', 'sc-preview__lead'));
      const dl = el('dl', '', 'sc-dl');
      const row = (k: string, v: string | Node) => { dl.append(el('dt', k)); const dd = el('dd'); dd.append(v); dl.append(dd); };
      row('Making', ({ post: 'A post', carousel: `A carousel of ${items.length} photos`, story: 'A Story', reel: 'A Reel' } as any)[b.f]);
      row('Going to', b.posts.map(p => p.platform).join(' and '));
      row('When', b.when ? `Facebook: ${when(new Date(b.when).toISOString())}${b.posts.length > 1 ? ' · Instagram: now' : ''}` : 'Straight away');
      items.forEach((it, i) => {
        let m: HTMLElement;
        if (it.kind === 'video') { const v = document.createElement('video'); v.src = it.thumb; v.controls = true; v.muted = true; v.playsInline = true; v.preload = 'metadata'; v.width = 120; v.className = 'sc-thumb'; v.setAttribute('aria-label', 'Video preview'); m = v; }
        else { const t = document.createElement('img'); t.src = it.thumb; t.alt = it.alt; t.width = 120; t.className = 'sc-thumb'; m = t; }
        row(it.kind === 'video' ? 'Video' : `Photo${items.length > 1 ? ' ' + (i + 1) : ''}`, m);
        row(it.kind === 'video' ? 'Description' : 'Alt text', it.alt);
      });
      if (b.f !== 'story') row(b.posts.length === 1 && b.posts[0].platform === 'Instagram' || b.f === 'reel' ? 'Caption' : 'Message', b.message || '(none)');
      else row('Caption', 'None: Stories carry no caption');
      if (b.posts[0].body.link) row('Link', b.posts[0].body.link);
      box.append(dl);
      const ok = el('button', 'Confirm and send', 'sc-btn sc-btn--go') as HTMLButtonElement; ok.type = 'button';
      const no = el('button', 'Cancel', 'sc-btn sc-btn--ghost') as HTMLButtonElement; no.type = 'button';
      no.onclick = () => { box.hidden = true; inp('#text').focus(); };
      ok.onclick = async () => {
        ok.disabled = no.disabled = true;
        const done: string[] = [], failed: string[] = [];
        for (const p of b.posts) {
          try { await sendConfirmed(p.body); done.push(p.platform); }
          catch (err: any) { failed.push(`${p.platform}: ${err.message}`); }
        }
        if (!failed.length) {
          say(`Sent to ${done.join(' and ')}. It is in the activity log.`, true);
          (document.getElementById('composer') as HTMLFormElement).reset(); items = []; renderMedia(); box.hidden = true; sync(); load();
        } else {
          say(`${done.length ? `Sent to ${done.join(' and ')}. ` : ''}Not sent: ${failed.join(' · ')}`);
          ok.disabled = no.disabled = false; if (done.length) { box.hidden = true; load(); }
        }
      };
      const act = el('div', '', 'sc-actions'); act.append(ok, no);
      box.append(act); box.hidden = false; box.focus();
    } catch (err: any) { say(err.message); }
    finally { btn.disabled = false; }
  });

  // ── Accounts and recent posts ────────────────────────────────────────────
  function showAccounts(o: any) {
    const wrap = $('#sc-accounts');
    wrap.replaceChildren();
    const chip = (title: string, a: any, line: string) => {
      const c = el('div', '', 'sc-chip');
      c.append(el('strong', title));
      c.append(el('span', a?.error ? a.error : line, a?.error ? 'sc-warn' : ''));
      wrap.append(c);
    };
    const fb = o.facebook, ig = o.instagram;
    chip('Facebook', fb, `${fb.name} · ${fb.followers_count ?? fb.fan_count ?? '?'} followers`);
    chip('Instagram', ig, `@${ig.username} · ${ig.followers_count ?? '?'} followers · ${ig.media_count ?? '?'} posts`);
  }

  function showPosts(listId: string, items: any[], kind: 'fb' | 'ig') {
    const ul = $(listId);
    ul.replaceChildren();
    if (!items.length) { ul.append(el('li', 'Nothing yet.', 'sc-muted')); return; }
    for (const p of items) {
      const li = el('li', '', 'sc-item');
      const pic = safeImg(kind === 'fb' ? p.full_picture : p.thumbnail_url || p.media_url);
      if (pic) { const i = document.createElement('img'); i.src = pic; i.alt = ''; i.width = 56; i.height = 56; i.loading = 'lazy'; i.className = 'sc-pic'; li.append(i); }
      const body = el('div', '', 'sc-item__body');
      body.append(el('p', clip(kind === 'fb' ? p.message : p.caption) || '(no text)'));
      const n = kind === 'fb'
        ? `${p.reactions?.summary?.total_count ?? 0} reactions · ${p.comments?.summary?.total_count ?? 0} comments`
        : `${p.like_count ?? 0} likes · ${p.comments_count ?? 0} comments`;
      body.append(el('p', `${p.scheduled_publish_time ? 'Scheduled ' + when(new Date(p.scheduled_publish_time * 1000).toISOString()) : when(p.created_time || p.timestamp)} · ${n}`, 'sc-muted'));
      const b = el('button', 'Comments', 'sc-btn sc-btn--small') as HTMLButtonElement;
      b.type = 'button';
      b.onclick = () => openComments(kind, p.id);
      body.append(b);
      const href = p.permalink_url || p.permalink;
      if (typeof href === 'string' && /^https:\/\//.test(href)) {
        const a = el('a', 'Open', 'sc-btn sc-btn--small sc-btn--ghost') as HTMLAnchorElement;
        a.href = href; a.target = '_blank'; a.rel = 'noopener';
        a.setAttribute('aria-label', `Open this ${kind === 'fb' ? 'Facebook' : 'Instagram'} post in a new tab`);
        body.append(a);
      }
      li.append(body);
      ul.append(li);
    }
  }

  function tab(which: 'fb' | 'ig') {
    $('#fb-list').hidden = which !== 'fb'; $('#ig-list').hidden = which !== 'ig';
    $('#tab-fb').setAttribute('aria-pressed', String(which === 'fb')); $('#tab-ig').setAttribute('aria-pressed', String(which === 'ig'));
  }
  $('#tab-fb').addEventListener('click', () => tab('fb'));
  $('#tab-ig').addEventListener('click', () => tab('ig'));

  let openOne: ['fb' | 'ig', string] | null = null;
  async function openComments(kind: 'fb' | 'ig', id: string) {
    openOne = [kind, id];
    const panel = $('#sc-comments'), ul = $('#sc-comments-list');
    panel.hidden = false; ul.replaceChildren(el('li', 'Loading…', 'sc-muted')); panel.focus();
    try {
      const d = await api(`${kind}_comments`, `&id=${encodeURIComponent(id)}`);
      ul.replaceChildren();
      if (!d.data?.length) ul.append(el('li', 'No comments.', 'sc-muted'));
      for (const c of d.data ?? []) {
        const platform = kind === 'fb' ? 'facebook' : 'instagram';
        const hidden = kind === 'fb' ? c.is_hidden : c.hidden;
        const li = el('li', '', 'sc-item');
        li.append(el('p', `${kind === 'fb' ? c.from?.name ?? 'Someone' : '@' + c.username}: ${kind === 'fb' ? c.message : c.text}`));
        li.append(el('p', `${when(c.created_time || c.timestamp)}${hidden ? ' · hidden' : ''}`, 'sc-muted'));
        const reply = el('button', 'Reply', 'sc-btn sc-btn--small') as HTMLButtonElement;
        reply.type = 'button';
        reply.onclick = () => {
          const form = el('form', '', 'sc-reply') as HTMLFormElement;
          const lab = el('label', 'Your reply'); const id2 = `r-${c.id}`; lab.setAttribute('for', id2);
          const ta = el('textarea') as HTMLTextAreaElement; ta.id = id2; ta.rows = 2; ta.maxLength = 2200; ta.required = true;
          const go = el('button', 'Preview', 'sc-btn sc-btn--small') as HTMLButtonElement; go.type = 'submit';
          form.append(lab, ta, go);
          form.onsubmit = async e => {
            e.preventDefault();
            const body = { action: 'reply', platform, comment_id: c.id, message: ta.value.trim() };
            try {
              const pv = await send({ ...body, confirm: false });
              if (window.confirm(`Send this reply publicly?\n\n${pv.preview.message}`)) { await send({ ...body, confirm: true }); say('Reply sent.'); form.remove(); }
            } catch (err: any) { say(err.message); }
          };
          reply.after(form); ta.focus();
        };
        const hide = el('button', hidden ? 'Unhide' : 'Hide', 'sc-btn sc-btn--small sc-btn--ghost') as HTMLButtonElement;
        hide.type = 'button';
        hide.onclick = async () => {
          const body = { action: 'hide', platform, comment_id: c.id, hidden: !hidden };
          if (!window.confirm(`${hidden ? 'Unhide' : 'Hide'} this comment? You can reverse it.`)) return;
          try { await send({ ...body, confirm: true }); say(hidden ? 'Comment unhidden.' : 'Comment hidden.'); openComments(kind, id); }
          catch (err: any) { say(err.message); }
        };
        li.append(reply, hide);
        ul.append(li);
      }
    } catch (err: any) { ul.replaceChildren(el('li', err.message, 'sc-muted')); }
  }

  $('#sc-refresh').addEventListener('click', async () => { say('Refreshing…'); await load(); if (openOne && !$('#sc-comments').hidden) openComments(...openOne); });
  $('#sc-comments-refresh').addEventListener('click', () => { if (openOne) openComments(...openOne); });

  // Posts | Comments views. Opening a link with #comments or an inbox filter shows Comments.
  function view(which: 'posts' | 'comments', pushHash = true) {
    $('#sc-view-posts').hidden = which !== 'posts';
    $('#sc-view-comments').hidden = which !== 'comments';
    $('#view-posts').setAttribute('aria-pressed', String(which === 'posts'));
    $('#view-comments').setAttribute('aria-pressed', String(which === 'comments'));
    if (which === 'comments') window.dispatchEvent(new Event('cm-visible'));
    if (pushHash) history.replaceState(null, '', which === 'comments' ? `${location.pathname}${location.search}#comments` : `${location.pathname}${location.search}`);
  }
  $('#view-posts').addEventListener('click', () => view('posts'));
  $('#view-comments').addEventListener('click', () => view('comments'));
  const waiting = Number(document.getElementById('comments')?.dataset.waiting || 0);
  if (waiting > 0) { const n = $('#view-comments-n'); n.textContent = String(waiting); n.hidden = false; }
  // Which view to open on. A link that asks for comments (#comments or an inbox filter) always wins. Otherwise the
  // person's own choice, kept in this browser only; "Most pressing" (the default) opens on Comments when some are
  // waiting to be tagged, and on Posts when not.
  const PREF = 'social-open-on';
  const readPref = () => { try { const v = localStorage.getItem(PREF); return v === 'posts' || v === 'comments' ? v : 'auto'; } catch { return 'auto'; } };
  const sp = new URLSearchParams(location.search);
  const asked = location.hash === '#comments' || sp.has('status') || sp.has('event');
  const pref = readPref();
  (document.getElementById('view-pref') as HTMLSelectElement).value = pref;
  view(asked ? 'comments' : pref === 'auto' ? (waiting > 0 ? 'comments' : 'posts') : pref, false);
  // A link to #comments clicked while already on this page.
  window.addEventListener('hashchange', () => { if (location.hash === '#comments') view('comments', false); });
  document.getElementById('view-pref')!.addEventListener('change', (e) => {
    const v = (e.target as HTMLSelectElement).value;
    try { v === 'auto' ? localStorage.removeItem(PREF) : localStorage.setItem(PREF, v); } catch { /* choice just won't be remembered */ }
    say(v === 'auto' ? 'Social will open on whichever needs you most.' : `Social will open on ${v === 'posts' ? 'Posts' : 'Comments'}.`, true);
  });

  async function load() {
    try {
      const o = await api('overview');
      if (!o.status.connected) { say('Meta is not connected yet. Ask Chris to add the access token and the Page and Instagram ids (DEPLOY.md).'); return; }
      say('Connected to Meta', true);
      showAccounts(o);
      const [fb, ig] = await Promise.allSettled([api('fb_posts'), api('ig_media')]);
      showPosts('#fb-list', fb.status === 'fulfilled' ? fb.value.data ?? [] : [], 'fb');
      showPosts('#ig-list', ig.status === 'fulfilled' ? ig.value.data ?? [] : [], 'ig');
    } catch (err: any) { say(err.message); }
  }
  sync();
  load();
</script>

<style>
  .sc-section { background: var(--ink); padding-block: clamp(var(--space-6), 5vw, var(--space-10)); min-height: calc(100svh - var(--nav-h)); }
