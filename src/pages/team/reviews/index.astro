---
// All review checkpoints from the schedule, with their period and write-up status. Leads only.
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { reviewPeriods, fmtDate } from '../../../lib/metrics.js';
import { ukToday } from '../../../lib/dates.js';

const authEmail = Astro.request.headers.get('Cf-Access-Authenticated-User-Email');
const db = Astro.locals.runtime?.env?.OPS_DB;
let periods: any[] = [];
let writeUps = new Map<number, any>();
if (db) {
  const [s, w] = await Promise.all([
    db.prepare('SELECT * FROM schedule_items ORDER BY start_date').all(),
    db.prepare('SELECT * FROM reviews').all().catch(() => ({ results: [] })),
  ]);
  periods = reviewPeriods(s.results);
  writeUps = new Map(w.results.map((r: any) => [r.schedule_id, r]));
}
const today = ukToday();
function status(p: any) {
  const w = writeUps.get(p.review.id);
  if (w?.signed_off_at) return { key: 'done', text: 'Signed off' };
  if (today > p.review.end_date) return { key: 'overdue', text: w ? 'Written, not signed off' : 'Overdue' };
  if (today >= p.review.start_date) return { key: 'due', text: w ? 'In progress' : 'Review week now' };
  return { key: 'upcoming', text: w ? 'Started early' : 'Upcoming' };
}
---
<BaseLayout title="Reviews · Between Ops" nav="internal" authEmail={authEmail}>
  <main id="main">
    <section class="rv-section">
      <div class="container">
        <h1 class="rv-heading">Reviews</h1>
        <p class="rv-intro">
          The formal checkpoints from the ACE application. Each review pulls together its period live (events,
          attendance, survey results, community growth, targets, spend, stories, schedule), with space for the
          team's reflections and a sign-off. Print or save as PDF for the board or Arts Council England.
        </p>
        <ul class="rv-list" role="list">
          {periods.map(p => {
            const s = status(p);
            return (
              <li class={`rv rv--${s.key}`}>
                <a href={`/team/reviews/${p.review.id}`} class="rv__name">{p.review.task}</a>
                <span class="rv__dates">Review week {fmtDate(p.review.start_date, { day: 'numeric', month: 'short' })}–{fmtDate(p.review.end_date)} · covers {fmtDate(p.from, { day: 'numeric', month: 'short' })} to {fmtDate(p.to, { day: 'numeric', month: 'short', year: 'numeric' })}</span>
                <span class={`rv__chip rv__chip--${s.key}`}>{s.text}</span>
              </li>
            );
          })}
        </ul>
        <p class="rv-note">The end-of-programme evaluation report is due to Arts Council England by 30 Nov 2027. Review dates come from the <a href="/team/schedule">schedule</a>.</p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .rv-section { background: var(--ink); padding-block: clamp(var(--space-8), 6vw, var(--space-12)); min-height: calc(100svh - var(--nav-h)); }
  .rv-heading { font-family: var(--font-body); color: var(--paper); font-size: var(--text-2xl); margin-bottom: var(--space-2); }
  .rv-intro { color: var(--body); font-size: var(--text-sm); max-width: 70ch; margin-bottom: var(--space-6); }
  .rv-list { list-style: none; margin: 0 0 var(--space-4); padding: 0; background: var(--ink-soft); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .rv { display: grid; grid-template-columns: 1fr auto; gap: 0.25rem var(--space-3); padding: var(--space-4); border-left: 4px solid var(--line); }
  .rv + .rv { border-top: 1px solid var(--line); }
  .rv--due { border-left-color: var(--ember); }
  .rv--overdue { border-left-color: var(--red); }
  .rv--done { border-left-color: #4caf50; }
  .rv__name { color: var(--paper); font-weight: 700; text-decoration: none; }
  .rv__name:hover { color: var(--ember); text-decoration: underline; }
  .rv__name:focus-visible { outline: 3px solid var(--ember); outline-offset: 2px; }
  .rv__dates { grid-column: 1; font-size: var(--text-xs); color: var(--body); }
  .rv__chip { grid-row: 1 / span 2; grid-column: 2; align-self: center; font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; padding: 0.2rem 0.5rem; border: 1px solid currentColor; border-radius: var(--radius-sm); color: var(--body); }
  .rv__chip--due { color: var(--ember); }
  .rv__chip--overdue { color: #ff8080; }
  .rv__chip--done { color: #4caf50; }
  .rv-note { font-size: var(--text-xs); color: var(--body); }
  .rv-note a { color: var(--ember); }
</style>
