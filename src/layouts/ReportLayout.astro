---
// Printable report pages under /team (survey reports, community growth, quarterly reviews).
// Light, print-first styling; leads only via src/middleware.js.
interface Props { title: string; back?: { href: string; label: string } }
const { title, back = { href: '/team/evaluation', label: 'Evaluation' } } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Between Ops</title>
    <style is:global>
      @font-face { font-family: 'Fraunces'; src: url('/fonts/fraunces/fraunces-normal-latin.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
      @font-face { font-family: 'Hanken Grotesk'; src: url('/fonts/hanken/hanken-400-latin.woff2') format('woff2'); font-weight: 400; font-display: swap; }
      @font-face { font-family: 'Hanken Grotesk'; src: url('/fonts/hanken/hanken-600-latin.woff2') format('woff2'); font-weight: 600 700; font-display: swap; }
      @page { size: A4; margin: 14mm; }
      * { box-sizing: border-box; }
      body { margin: 0; background: #F4EFEA; color: #1A1212; font: 15px/1.55 'Hanken Grotesk', -apple-system, Arial, sans-serif; }
      a { color: #C8102E; }
      .toolbar { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; justify-content: space-between; padding: 0.8rem 1rem; background: #1A1212; }
      .toolbar a, .toolbar button { font: 600 0.9rem/1 'Hanken Grotesk', Arial, sans-serif; padding: 0.6rem 0.9rem; border-radius: 6px; text-decoration: none; cursor: pointer; }
      .toolbar a { color: #F4EFEA; border: 1px solid #3A2C2C; }
      .toolbar button { background: #C8102E; color: #fff; border: 0; }
      .toolbar :focus-visible, .report :focus-visible { outline: 3px solid #E8A23D; outline-offset: 2px; }
      .report { max-width: 980px; margin: 1.5rem auto; padding: 2rem clamp(1rem, 4vw, 2.5rem); background: #fff; border-top: 8px solid #C8102E; border-radius: 6px; }
      .r-eyebrow { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #5a4848; margin: 0; }
      .r-title { font-family: 'Fraunces', Georgia, serif; font-size: clamp(1.8rem, 5vw, 2.6rem); line-height: 1.05; margin: 0.3rem 0 0.4rem; }
      .r-sub { color: #5a4848; margin: 0 0 1.5rem; }
      .r-h2 { font-family: 'Fraunces', Georgia, serif; font-size: 1.35rem; margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid #e3d9d2; }
      .r-h3 { font-size: 0.95rem; margin: 1rem 0 0.4rem; }
      .r-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.6rem; margin: 0; padding: 0; list-style: none; }
      .r-stats li { background: #F4EFEA; border-radius: 6px; padding: 0.8rem; }
      .r-stats strong { display: block; font-family: 'Fraunces', Georgia, serif; font-size: 1.6rem; line-height: 1.1; color: #C8102E; }
      .r-stats span { font-size: 0.8rem; color: #5a4848; }
      .r-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; font-variant-numeric: tabular-nums; }
      .r-table th, .r-table td { padding: 0.4rem 0.5rem; border-bottom: 1px solid #e3d9d2; text-align: right; }
      .r-table th:first-child, .r-table td:first-child { text-align: left; }
      .r-table thead th { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; color: #5a4848; vertical-align: bottom; }
      .r-table tfoot td { font-weight: 700; border-top: 2px solid #1A1212; }
      .r-table .up { color: #2e7d32; } .r-table .down { color: #C8102E; }
      .r-table .change { display: block; font-size: 0.75rem; }
      .r-table-wrap { overflow-x: auto; }
      .r-bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
      .r-bars li { display: grid; grid-template-columns: minmax(0, 15rem) 1fr 5.5rem; gap: 0.6rem; align-items: center; font-size: 0.88rem; }
      .r-bars .track { height: 10px; background: #F4EFEA; border-radius: 5px; overflow: hidden; }
      .r-bars .track span { display: block; height: 100%; background: #E8A23D; }
      .r-bars .n { text-align: right; font-variant-numeric: tabular-nums; }
      .r-quotes { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.6rem; }
      .r-quotes li { border-left: 3px solid #E8A23D; padding-left: 0.75rem; }
      .r-note { font-size: 0.85rem; color: #5a4848; }
      .r-grid2 { display: grid; gap: 1rem; }
      @media (min-width: 760px) { .r-grid2 { grid-template-columns: 1fr 1fr; } }
      .r-target { margin: 0 0 0.6rem; }
      .r-target .track { height: 12px; background: #F4EFEA; border-radius: 6px; overflow: hidden; margin-top: 0.25rem; }
      .r-target .track span { display: block; height: 100%; background: #C8102E; }
      .r-sign { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid #e3d9d2; font-size: 0.85rem; color: #5a4848; }
      @media print {
        body { background: #fff; font-size: 12px; }
        .toolbar, .no-print { display: none !important; }
        .report { margin: 0; padding: 0; border: 0; max-width: none; }
        .r-h2 { break-after: avoid; }
        .r-table, .r-bars, .r-stats { break-inside: avoid; }
      }
    </style>
  </head>
  <body>
    <div class="toolbar">
      <a href={back.href}>← {back.label}</a>
      <span><slot name="actions" /> <button type="button" onclick="window.print()">Print / save as PDF</button></span>
    </div>
    <main class="report">
      <slot />
      <p class="r-sign">The Space Between · Sonic Boom Music CIC · Arts Council England Supporting Grassroots Music (SGRM-00869135-R11). Anonymous aggregate data. Believe in the Power of Music.</p>
    </main>
  </body>
</html>
