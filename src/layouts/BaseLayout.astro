---
import SiteNav from '../components/SiteNav.astro';
import TeamNav from '../components/TeamNav.astro';
import TeamHelp from '../components/TeamHelp.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  // 'minimal' is for the open /feedback pages: brand only, no links into the PIN-gated site.
  nav?: 'public' | 'internal' | 'minimal';
  authEmail?: string | null;
}

const {
  title = 'The Space Between · Sonic Boom Music CIC',
  description = 'The year-round home of music in Burton upon Trent. One free or low-cost event a month, all year. Join the community.',
  ogImage = '/img/og.jpg',
  nav = 'public',
  authEmail = null,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

// Cloudflare Web Analytics (cookieless). The token is public, not a secret: Cloudflare dashboard →
// Analytics & Logs → Web Analytics → between.sonicboom.org.uk → Manage site → JS snippet.
// Empty = no analytics script on the page.
const WEB_ANALYTICS_TOKEN = '691a25c25a2b4921a3554bee800e01ef';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {nav === 'internal' && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / Twitter -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonical} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:card"       content="summary_large_image" />
    <meta name="twitter:title"      content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"      content={new URL(ogImage, Astro.site)} />

    <!-- Favicon (TODO: replace with final set) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Preload critical fonts — latin subset only -->
    <link
      rel="preload"
      href="/fonts/fraunces/fraunces-normal-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/hanken/hanken-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {nav === 'internal' && (
      <>
        <!-- The team area installs as an app ("Between Ops"): see /team/help and public/between-ops-sw.js. -->
        <link rel="manifest" href="/between-ops.webmanifest" />
        <meta name="theme-color" content="#1A1212" />
        <link rel="apple-touch-icon" href="/img/app/apple-touch-icon.png" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-title" content="Between Ops" />
        <meta name="apple-mobile-web-app-status-bar-style" content="black" />
        <!-- Apply the Help switch before the page paints (remembered per device; see TeamHelp). -->
        <script is:inline>try { if (localStorage.getItem('between-ops-help') === 'off') document.documentElement.dataset.help = 'off'; } catch {}</script>
      </>
    )}

    {WEB_ANALYTICS_TOKEN && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: WEB_ANALYTICS_TOKEN })}></script>
    )}
  </head>
  <body class={nav === 'internal' ? 'is-team' : undefined}>
    <a href="#main" class="skip-link">Skip to content</a>
    {nav === 'internal' && <TeamNav authEmail={authEmail} />}
    {nav === 'internal' && <TeamHelp />}
    {nav === 'public' && <SiteNav />}
    {nav === 'minimal' && (
      <header class="mini-nav" role="banner">
        <div class="container mini-nav__inner">
          <span class="mini-nav__name">The Space Between</span>
          <span class="mini-nav__by">Sonic Boom Music CIC</span>
        </div>
      </header>
    )}
    <slot />
    <Footer />
    {nav !== 'internal' && (
      <script is:inline>
        // Anonymous count of clicks on tracked links (e.g. joining WhatsApp), credited to this page's
        // campaign tags. No cookies, nothing stored on the device. See src/lib/attribution.js.
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[data-track]');
          if (a && navigator.sendBeacon) navigator.sendBeacon('/api/attribution', JSON.stringify({ kind: a.getAttribute('data-track') }));
        });
      </script>
    )}
  </body>
</html>

<style>
  .mini-nav {
    background: var(--ink);
    border-bottom: 1px solid var(--line);
  }
  .mini-nav__inner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: var(--nav-h);
    line-height: 1.15;
  }
  .mini-nav__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-base);
    color: var(--paper);
  }
  .mini-nav__by {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ember);
  }
</style>
