---
// Burton's stories: the people behind The Space Between, in their own words. People share them at
// /feedback/story; a lead approves them in /team/stories and they show here straight away (the
// home page renders per request). Only ever real stories, shared with permission.
import events from '../data/events.json';
import { ukToday } from '../lib/dates.js';

const db = Astro.locals.runtime?.env?.OPS_DB;
let stories: any[] = [];
if (db) {
  try {
    const { results } = await db
      .prepare(`SELECT story, credit, about, event_slug FROM stories
                WHERE status = 'approved' AND consent_web = 1 ORDER BY reviewed_at DESC LIMIT 6`)
      .all();
    stories = results;
  } catch { /* table missing locally: show the invitation instead */ }
}

const nextEvent = events.find(e => e.date >= ukToday()) ?? events[0];
const eventName = (slug?: string) => events.find(e => e.slug === slug)?.name;
const shareHref = '/feedback/story?utm_source=between&utm_medium=home&utm_campaign=stories';
---

<section id="stories" class="stories-section" aria-labelledby="stories-heading">
  <div class="container">
    <p class="stories-eyebrow">Burton's stories</p>
    <h2 id="stories-heading" class="stories-heading">Every night has a story. We want&nbsp;yours.</h2>
    <p class="stories-intro">
      The Space Between is being written by the people who come. At every event we're gathering
      stories: the first gig you went to, the song your family always sang, the band that got you
      through, the friend you made in the queue. We'll share them here, with your permission.
    </p>

    {stories.length > 0 ? (
      <ul class="stories-list" role="list">
        {stories.map((s: any) => (
          <li class="story">
            <blockquote class="story__quote"><p>{s.story}</p></blockquote>
            <p class="story__who">
              <strong>{s.credit || 'Anonymous'}</strong>{s.about && <>, {s.about}</>}
              {eventName(s.event_slug) && <span class="story__event"> · {eventName(s.event_slug)}</span>}
            </p>
          </li>
        ))}
      </ul>
    ) : (
      <p class="stories-first">
        The first stories will come from <strong>{nextEvent.name}</strong>. Come and be part of them.
      </p>
    )}

    <div class="stories-actions">
      <a class="btn btn-primary" href={shareHref}>Share your story</a>
      <a class="btn stories-btn-ghost" href="/#signup">Join the community</a>
    </div>
  </div>
</section>

<style>
  .stories-section {
    background: var(--ink);
    padding-block: clamp(var(--space-12), 9vw, var(--space-20));
    border-top: 3px solid var(--red);
  }
  .stories-eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ember);
    margin: 0 0 var(--space-3);
  }
  .stories-heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.05;
    color: var(--paper);
    margin: 0 0 var(--space-5);
    max-width: 18ch;
  }
  .stories-intro {
    font-family: var(--font-body);
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.75;
    color: var(--body);
    max-width: 58ch;
    margin: 0 0 var(--space-8);
  }
  .stories-first {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.4vw, 1.35rem);
    font-style: italic;
    color: var(--paper);
    border-left: 3px solid var(--ember);
    padding-left: var(--space-4);
    margin: 0 0 var(--space-8);
    max-width: 50ch;
  }
  .stories-first strong { font-style: normal; color: var(--ember); }

  .stories-list {
    list-style: none;
    margin: 0 0 var(--space-8);
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 760px) { .stories-list { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .stories-list { grid-template-columns: repeat(3, 1fr); } }
  .story {
    background: var(--ink-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius-md, 10px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .story__quote { margin: 0; padding: var(--space-5) var(--space-5) var(--space-3); }
  .story__quote p {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.5;
    color: var(--paper);
    margin: 0;
  }
  .story__quote p::before { content: '\201C'; color: var(--ember); }
  .story__quote p::after { content: '\201D'; color: var(--ember); }
  .story__who {
    padding: 0 var(--space-5) var(--space-5);
    margin: auto 0 0;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--body);
  }
  .story__who strong { color: var(--paper); }
  .story__event { color: var(--ember); }

  .stories-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .stories-btn-ghost {
    border: 2px solid var(--line);
    color: var(--paper);
    background: transparent;
  }
  .stories-btn-ghost:hover { border-color: var(--ember); color: var(--ember); }
  .stories-actions .btn:focus-visible { outline: 3px solid var(--ember); outline-offset: 3px; }
</style>
