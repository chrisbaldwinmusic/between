---
// Burton's stories: the people behind The Space Between, in their own words. Stories live in
// src/data/stories.json and are only ever real, shared with permission. Never invent them.
//
// Each story: { "quote": "...", "name": "First name or how they'd like to be credited",
//   "about": "e.g. came to Firelight with her gran", "event": "firelight" (optional slug),
//   "image": "/img/stories/....jpg" (optional), "imageAlt": "..." (required if image) }
import stories from '../data/stories.json';
import events from '../data/events.json';

const nextEvent = events.find(e => e.date >= new Date().toISOString().slice(0, 10)) ?? events[0];
const eventName = (slug?: string) => events.find(e => e.slug === slug)?.name;
const shareHref = 'mailto:hello@sonicboom.org.uk?subject=My%20story%20-%20The%20Space%20Between';
---

<section id="stories" class="stories-section" aria-labelledby="stories-heading">
  <div class="container">
    <p class="stories-eyebrow">Burton's stories</p>
    <h2 id="stories-heading" class="stories-heading">Every night has a story. We want&nbsp;yours.</h2>
    <p class="stories-intro">
      The Space Between is being written by the people who come. At every event we're gathering
      stories: the first gig you went to, the song your family always sang, the band that got you
      through, the friend you made in the queue. We'll share them here, with your permission.
    </p>

    {stories.length > 0 ? (
      <ul class="stories-list" role="list">
        {stories.map((s: any) => (
          <li class="story">
            {s.image && <img class="story__img" src={s.image} alt={s.imageAlt} loading="lazy" decoding="async" />}
            <blockquote class="story__quote"><p>{s.quote}</p></blockquote>
            <p class="story__who">
              <strong>{s.name}</strong>{s.about && <>, {s.about}</>}
              {eventName(s.event) && <span class="story__event"> · {eventName(s.event)}</span>}
            </p>
          </li>
        ))}
      </ul>
    ) : (
      <p class="stories-first">
        The first stories will come from <strong>{nextEvent.name}</strong>. Come and be part of them.
      </p>
    )}

    <div class="stories-actions">
      <a class="btn btn-primary" href={shareHref}>Share your story</a>
      <a class="btn stories-btn-ghost" href="/#signup">Join the community</a>
    </div>
  </div>
</section>

<style>
  .stories-section {
    background: var(--ink);
    padding-block: clamp(var(--space-12), 9vw, var(--space-20));
    border-top: 3px solid var(--red);
  }
  .stories-eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ember);
    margin: 0 0 var(--space-3);
  }
  .stories-heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.05;
    color: var(--paper);
    margin: 0 0 var(--space-5);
    max-width: 18ch;
  }
  .stories-intro {
    font-family: var(--font-body);
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.75;
    color: var(--body);
    max-width: 58ch;
    margin: 0 0 var(--space-8);
  }
  .stories-first {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.4vw, 1.35rem);
    font-style: italic;
    color: var(--paper);
    border-left: 3px solid var(--ember);
    padding-left: var(--space-4);
    margin: 0 0 var(--space-8);
    max-width: 50ch;
  }
  .stories-first strong { font-style: normal; color: var(--ember); }

  .stories-list {
    list-style: none;
    margin: 0 0 var(--space-8);
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 760px) { .stories-list { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .stories-list { grid-template-columns: repeat(3, 1fr); } }
  .story {
    background: var(--ink-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius-md, 10px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .story__img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
  .story__quote { margin: 0; padding: var(--space-5) var(--space-5) var(--space-3); }
  .story__quote p {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.5;
    color: var(--paper);
    margin: 0;
  }
  .story__quote p::before { content: '\201C'; color: var(--ember); }
  .story__quote p::after { content: '\201D'; color: var(--ember); }
  .story__who {
    padding: 0 var(--space-5) var(--space-5);
    margin: auto 0 0;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--body);
  }
  .story__who strong { color: var(--paper); }
  .story__event { color: var(--ember); }

  .stories-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .stories-btn-ghost {
    border: 2px solid var(--line);
    color: var(--paper);
    background: transparent;
  }
  .stories-btn-ghost:hover { border-color: var(--ember); color: var(--ember); }
  .stories-actions .btn:focus-visible { outline: 3px solid var(--ember); outline-offset: 3px; }
</style>
