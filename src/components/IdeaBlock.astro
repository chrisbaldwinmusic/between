---
// The rationale. The Space Between is a community and audience development programme: the
// events are how we bring people in, not the point. Sourced from the ACE application.
const pillars = [
  {
    title: 'Bring people together',
    body: "Every event is a reason to meet: neighbours, families, friends of friends. Our WhatsApp community keeps those connections going between nights.",
  },
  {
    title: 'Open the door wider',
    body: "Not everyone calls themselves a music fan, and they're exactly who we want to meet. Free daytime events, family sessions, a youth-run night and community-curated music give everyone a way in.",
  },
  {
    title: "Tell Burton's story",
    body: "Every event gathers the stories of the people in the room: why they came, who they came with, what music means to them. We share them back, so the town can see itself.",
  },
];
---

<section id="idea" class="idea-section" aria-labelledby="idea-heading">
  <div class="container">

    <div class="idea-inner">

      <div class="idea-copy">
        <p class="idea-eyebrow">Why we're doing this</p>
        <h2 id="idea-heading" class="idea-heading">
          It's not about the gigs. It's about the&nbsp;people.
        </h2>
        <p class="idea-body">
          Sonic Boom Festival brings thousands of people together for one free day every
          September. Then the stage comes down. The months in between are where a
          community either holds together or drifts apart.
        </p>
        <p class="idea-body">
          The Space Between is a year of holding it together. The music is how we bring
          people in. What we're really building is a community: people who know each other,
          come back, bring their friends, and have a say in what Burton sounds like next.
        </p>
      </div>

      <ol class="idea-pillars" role="list">
        {pillars.map((p, i) => (
          <li class={`pillar${i === 2 ? ' pillar--red' : ''}`}>
            <span class="pillar__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="pillar__title">{p.title}</h3>
            <p class="pillar__body">{p.body}</p>
          </li>
        ))}
      </ol>

    </div>

    <p class="idea-close">
      And every person who joins, comes back and adds their voice helps build the case for our
      ambition: a permanent home for grassroots music in Burton.
    </p>

  </div>
</section>

<style>
  /* ── Section ──────────────────────────────────────────────────────────── */
  .idea-section {
    background: var(--paper);
    padding-block: clamp(var(--space-12), 9vw, var(--space-20));
  }

  /* ── Inner layout: copy left, loop right on wide screens ─────────────── */
  .idea-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(var(--space-10), 6vw, var(--space-14));
  }

  @media (min-width: 900px) {
    .idea-inner {
      flex-direction: row;
      align-items: flex-start;
      gap: clamp(var(--space-12), 6vw, var(--space-16));
    }
    .idea-copy {
      flex: 0 0 min(46%, 520px);
    }
    .idea-pillars {
      flex: 1;
    }
  }

  /* ── Copy ─────────────────────────────────────────────────────────────── */
  .idea-heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    font-optical-sizing: auto;
    line-height: 1.05;
    color: var(--ink);
    margin-bottom: var(--space-6);
  }

  .idea-body {
    font-family: var(--font-body);
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.75;
    color: var(--ink-soft);
    max-width: 52ch;
    margin-bottom: var(--space-5);
  }
  .idea-body:last-child { margin-bottom: 0; }

  .idea-eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--red);
    margin: 0 0 var(--space-3);
  }

  /* ── Pillars ──────────────────────────────────────────────────────────── */
  .idea-pillars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .pillar {
    background: #fff;
    border-left: 4px solid var(--ember);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    padding: var(--space-5);
    box-shadow: 0 2px 10px rgba(26, 18, 18, 0.07);
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--space-4);
    row-gap: var(--space-1);
  }
  .pillar--red { border-color: var(--red); }

  .pillar__num {
    grid-row: span 2;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--ember);
    line-height: 1.1;
  }
  .pillar--red .pillar__num { color: var(--red); }

  .pillar__title {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.2vw, 1.3rem);
    font-weight: 700;
    color: var(--ink);
    line-height: 1.2;
    margin: 0;
  }

  .pillar__body {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--ink-soft);
    line-height: 1.6;
    margin: 0;
  }

  .idea-close {
    margin: clamp(var(--space-8), 5vw, var(--space-12)) 0 0;
    padding-top: var(--space-6);
    border-top: 1px solid #e3d9d2;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.6vw, 1.5rem);
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
    max-width: 48ch;
  }
</style>
