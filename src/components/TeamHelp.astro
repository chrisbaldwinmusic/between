---
// "How this page works": a fold-out at the top of each /team page that has an entry in
// src/lib/team-help.js. Tap it to open or close; the choice is remembered on the device and applies
// to every page. It starts open for someone new. The full guide is /team/help ("Help guide").
import { helpFor, tipsFor } from '../lib/team-help.js';
import { getEmail, isLead, isCommunity } from '../lib/team-access.js';

const email = getEmail(Astro.request);
const entry = helpFor(Astro.url.pathname);
const tips = entry ? tipsFor(entry, { lead: isLead(email), community: isCommunity(email) }) : [];
---
{entry && (
  <details class="page-help" open>
    <summary class="page-help__summary">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.3a2.6 2.6 0 0 1 5 .9c0 1.7-2.5 2.2-2.5 3.8"/><path d="M12 17.2v.1"/></svg>
      How this page works
    </summary>
    <div class="page-help__inner">
      <p class="page-help__what">{entry.what}</p>
      {tips.length > 0 && <ul class="page-help__tips">{tips.map(t => <li>{t}</li>)}</ul>}
      <p class="page-help__more"><a href="/team/help">Help guide</a>: getting the app, notifications and every page.</p>
    </div>
  </details>
  <!-- Close it before the page paints if it was closed last time (remembered per device). -->
  <script is:inline>(() => { const d = document.querySelector('details.page-help'); try { if (localStorage.getItem('between-ops-help') === 'closed') d.open = false; } catch {} d.addEventListener('toggle', () => { try { localStorage.setItem('between-ops-help', d.open ? 'open' : 'closed'); } catch {} }); })();</script>
)}

<style>
  .page-help { background: #241A1A; border-bottom: 1px solid var(--line); border-left: 3px solid var(--ember); font-family: var(--font-body); font-size: var(--text-sm); color: var(--body); }
  .page-help__summary {
    max-width: 72rem; margin: 0 auto; padding: 0.6rem var(--space-4); min-height: 2.75rem; box-sizing: border-box;
    display: flex; align-items: center; gap: 0.5rem; cursor: pointer; list-style: none;
    font-size: var(--text-xs); font-weight: 700; color: var(--ember);
  }
  .page-help__summary::-webkit-details-marker { display: none; }
  .page-help__summary svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; flex-shrink: 0; }
  .page-help__summary::after { content: '▸'; margin-left: auto; color: var(--body); }
  .page-help[open] .page-help__summary::after { content: '▾'; }
  .page-help__summary:hover { color: var(--paper); }
  .page-help__summary:focus-visible { outline: 3px solid var(--ember); outline-offset: -3px; }
  .page-help__inner { max-width: 72rem; margin: 0 auto; padding: 0 var(--space-4) var(--space-3); }
  .page-help__what { margin: 0 0 var(--space-2); color: var(--paper); }
  .page-help__tips { margin: 0 0 var(--space-2); padding-left: 1.2rem; display: flex; flex-direction: column; gap: 0.3rem; }
  .page-help__more { margin: 0; font-size: var(--text-xs); }
  .page-help a { color: var(--ember); font-weight: 700; }
  .page-help a:focus-visible { outline: 3px solid var(--ember); outline-offset: 2px; }
  @media print { .page-help { display: none; } }
</style>
