---
import { canAccess } from '../lib/team-access.js';

interface Props {
  authEmail?: string | null;
}
const { authEmail = null } = Astro.props;

const links = [
  { href: '/team',            label: 'Dashboard'  },
  { href: '/team/schedule',   label: 'Schedule'   },
  { href: '/team/todos',      label: 'To-dos'     },
  { href: '/team/budget',     label: 'Budget'     },
  { href: '/team/evaluation', label: 'Evaluation' },
  { href: '/team/stories',    label: 'Stories'    },
  { href: '/team/ops',        label: 'Ops'        },
].filter(({ href }) => canAccess(authEmail?.toLowerCase() ?? null, href));

// Highlight the section, including sub-pages like /team/evaluation/qr.
const path = Astro.url.pathname.replace(/\/$/, '') || '/team';
const isCurrent = (href: string) => (href === '/team' ? path === '/team' : path === href || path.startsWith(`${href}/`));

const initials = authEmail
  ? authEmail.split('@')[0].split(/[._-]/).filter(Boolean).slice(0, 2).map(p => p[0].toUpperCase()).join('')
  : '?';
---

<header class="tnav" role="banner">
  <div class="tnav__inner container">

    <a href="/team" class="tnav__brand">
      <span class="tnav__brand-name">Between Ops</span>
      <span class="tnav__badge">Team only</span>
    </a>

    <div class="tnav__account">
      {authEmail ? (
        <>
          <span class="tnav__avatar" aria-hidden="true">{initials}</span>
          <span class="tnav__email">
            <span class="visually-hidden">Signed in as </span>{authEmail}
          </span>
          <a href="/cdn-cgi/access/logout" class="tnav__logout">Log out</a>
        </>
      ) : (
        <span class="tnav__email tnav__email--warn">No Access identity (local dev)</span>
      )}
    </div>

    <nav class="tnav__links" aria-label="Team navigation">
      <ul role="list">
        {links.map(({ href, label }) => (
          <li>
            <a href={href} class="tnav__link" aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>

  </div>
</header>

<style>
  .tnav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--ink);
    border-bottom: 1px solid var(--line);
    font-family: var(--font-body);
  }

  /* Phone: brand + account on one row, section links wrap underneath (never hidden off-screen). */
  .tnav__inner {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'brand account'
      'links links';
    align-items: center;
    gap: var(--space-2) var(--space-3);
    padding-block: var(--space-2);
  }

  .tnav__brand {
    grid-area: brand;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    min-height: 2.5rem;
  }
  .tnav__brand-name {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--paper);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .tnav__brand:hover .tnav__brand-name { color: var(--ember); }
  .tnav__badge {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--ember);
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  .tnav__account {
    grid-area: account;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }
  .tnav__avatar {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--ink-soft);
    border: 1px solid var(--line);
    color: var(--paper);
    font-size: 0.65rem;
    font-weight: 700;
    flex-shrink: 0;
  }
  .tnav__email {
    font-size: 0.75rem;
    color: var(--body);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    display: none;
  }
  .tnav__email--warn { display: inline; color: #ff8080; }
  .tnav__logout {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ember);
    white-space: nowrap;
    padding: 0.35rem 0.1rem;
  }
  .tnav__logout:hover { color: var(--paper); }

  .tnav__links { grid-area: links; min-width: 0; }
  .tnav__links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.25rem;
  }
  .tnav__link {
    display: block;
    text-align: center;
    white-space: nowrap;
    padding: 0.5rem 0.4rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--body);
    text-decoration: none;
    background: rgba(255, 255, 255, 0.03);
    transition: color var(--duration) var(--ease), background var(--duration) var(--ease);
  }
  .tnav__link:hover { color: var(--paper); background: rgba(255, 255, 255, 0.07); }
  .tnav__link[aria-current='page'] { color: var(--ink); background: var(--ember); }

  .tnav a:focus-visible {
    outline: 3px solid var(--ember);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* Wider phones / small tablets: email fits. */
  @media (min-width: 480px) {
    .tnav__email { display: inline; max-width: 14rem; }
  }
  @media (min-width: 640px) {
    .tnav__links ul { grid-template-columns: repeat(4, 1fr); }
  }

  /* Desktop: one row. Brand · links · account (initials only until there's room for the email). */
  @media (min-width: 1100px) {
    .tnav__inner {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'brand links account';
      gap: var(--space-5);
      min-height: var(--nav-h);
      padding-block: 0;
    }
    .tnav__links ul {
      display: flex;
      justify-content: center;
      gap: var(--space-1);
    }
    .tnav__link {
      background: transparent;
      font-size: var(--text-sm);
      padding: 0.5rem 0.75rem;
    }
    .tnav__email { display: none; }
  }
  @media (min-width: 1240px) {
    .tnav__email { display: inline; max-width: 16rem; }
  }

  .visually-hidden {
    position: absolute !important;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
