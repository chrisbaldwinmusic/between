---
interface Props {
  authEmail?: string | null;
}
const { authEmail = null } = Astro.props;

const links = [
  { href: '/team',          label: 'Dashboard' },
  { href: '/team/schedule', label: 'Schedule'  },
  { href: '/team/todos',    label: 'To-dos'    },
  { href: '/team/ops',      label: 'Ops'       },
];

const current = Astro.url.pathname.replace(/\/$/, '') || '/team';
---

<header class="team-nav" role="banner">
  <div class="team-nav__bar container">
    <span class="team-nav__badge">Team only</span>
    {authEmail ? (
      <p class="team-nav__who">
        Signed in as <strong>{authEmail}</strong>
        <a href="/cdn-cgi/access/logout" class="team-nav__logout">Log out</a>
      </p>
    ) : (
      <p class="team-nav__who team-nav__who--unverified">
        Access identity unavailable in this environment
      </p>
    )}
  </div>

  <div class="team-nav__inner container">

    <a href="/" class="team-nav__brand" aria-label="Back to the public site">
      <span class="team-nav__brand-name">Between Ops</span>
      <span class="team-nav__brand-by" aria-hidden="true">Sonic Boom internal</span>
    </a>

    <nav class="team-nav__links" aria-label="Team navigation">
      <ul role="list">
        {links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="team-nav__link"
              aria-current={current === href ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

  </div>
</header>

<style>
  .team-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--ink);
    border-bottom: 1px solid var(--line);
  }

  /* ── Identity bar ─────────────────────────────────────────────────────── */
  .team-nav__bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding-block: 0.4rem;
    background: var(--ink-soft);
    border-bottom: 1px solid var(--line);
    font-family: var(--font-body);
  }

  .team-nav__badge {
    flex-shrink: 0;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--ember);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .team-nav__who {
    font-size: 0.7rem;
    color: var(--body);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .team-nav__who strong {
    color: var(--paper);
    font-weight: 600;
  }
  .team-nav__who--unverified {
    color: #ff8080;
  }

  .team-nav__logout {
    color: var(--ember);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .team-nav__logout:hover { color: var(--paper); }
  .team-nav__logout:focus-visible {
    outline: 3px solid var(--ember);
    outline-offset: 2px;
  }

  /* ── Section nav bar ──────────────────────────────────────────────────── */
  .team-nav__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    height: var(--nav-h);
  }

  .team-nav__brand {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    text-decoration: none;
    flex-shrink: 0;
  }
  .team-nav__brand-name {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--paper);
    letter-spacing: -0.01em;
  }
  .team-nav__brand-by {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 500;
    color: var(--body);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .team-nav__brand:hover .team-nav__brand-name { color: var(--ember); }

  .team-nav__links {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .team-nav__links ul {
    display: flex;
    gap: var(--space-1);
  }
  .team-nav__link {
    display: block;
    white-space: nowrap;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--body);
    text-decoration: none;
    transition: color var(--duration) var(--ease), background var(--duration) var(--ease);
  }
  .team-nav__link:hover {
    color: var(--paper);
    background: rgba(255,255,255,0.04);
  }
  .team-nav__link[aria-current='page'] {
    color: var(--ink);
    background: var(--ember);
  }

  @media (min-width: 640px) {
    .team-nav__links ul { justify-content: flex-end; }
    .team-nav__link { font-size: var(--text-sm); }
  }
</style>
