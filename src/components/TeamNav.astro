---
// Team-area navigation: a sidebar with icons on desktop; on phones a slim top bar whose Menu
// button slides the same sidebar in. Links are filtered to what each person can open.
import { canAccess } from '../lib/team-access.js';

interface Props {
  authEmail?: string | null;
}
const { authEmail = null } = Astro.props;

// Simple 24px stroke icons (drawn for this project).
const ICONS: Record<string, string> = {
  dashboard: '<rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/>',
  schedule: '<rect x="3" y="4.5" width="18" height="16.5" rx="2"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4"/><path d="M7.5 13.5h3M13.5 13.5h3M7.5 17h3"/>',
  todos: '<rect x="3" y="3" width="18" height="18" rx="2.5"/><path d="M7.5 12.5l3 3 6-7"/>',
  budget: '<circle cx="12" cy="12" r="9"/><path d="M14.5 8.2a2.8 2.8 0 0 0-5 1.8c0 2.5.5 3.5-1.5 6h7M8.5 13h5"/>',
  evaluation: '<path d="M4 20V4M4 20h16"/><rect x="7.5" y="12" width="3" height="5" rx=".5"/><rect x="12.5" y="8" width="3" height="9" rx=".5"/><rect x="17.5" y="5" width="2.5" height="12" rx=".5"/>',
  stories: '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.5 4v-4h-1A.5.5 0 0 1 4 15.5z"/><path d="M8.5 8h7M8.5 11.5h5"/>',
  media: '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9.5" r="1.8"/><path d="M21 16l-5-5-8.5 9"/>',
  ops: '<path d="M9 4h6v3H9z"/><path d="M15 5.5h2.5A1.5 1.5 0 0 1 19 7v12.5a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 5 19.5V7a1.5 1.5 0 0 1 1.5-1.5H9"/><path d="M8.5 11.5h7M8.5 15h7M8.5 18.5h4"/>',
  help: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9.3a2.6 2.6 0 0 1 5 .9c0 1.7-2.5 2.2-2.5 3.8"/><path d="M12 17.2v.1"/>',
  site: '<path d="M14 4h6v6M20 4l-8.5 8.5"/><path d="M18 14v4.5a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 4 18.5v-11A1.5 1.5 0 0 1 5.5 6H10"/>',
};

const links = [
  { href: '/team',            label: 'Dashboard',  icon: 'dashboard'  },
  { href: '/team/schedule',   label: 'Schedule',   icon: 'schedule'   },
  { href: '/team/todos',      label: 'To-dos',     icon: 'todos'      },
  { href: '/team/budget',     label: 'Budget',     icon: 'budget'     },
  { href: '/team/evaluation', label: 'Evaluation', icon: 'evaluation' },
  { href: '/team/stories',    label: 'Stories',    icon: 'stories'    },
  { href: '/team/media',      label: 'Media',      icon: 'media'      },
  { href: '/team/ops',        label: 'Ops',        icon: 'ops'        },
  { href: '/team/help',       label: 'Help guide', icon: 'help'       },
].filter(({ href }) => canAccess(authEmail?.toLowerCase() ?? null, href));

// Highlight the section, including sub-pages (e.g. /team/evaluation/community-report, /team/reviews).
const path = Astro.url.pathname.replace(/\/$/, '') || '/team';
const isCurrent = (href: string) =>
  href === '/team' ? path === '/team'
  : href === '/team/evaluation' ? path.startsWith('/team/evaluation') || path.startsWith('/team/reviews')
  : path === href || path.startsWith(`${href}/`);

const initials = authEmail
  ? authEmail.split('@')[0].split(/[._-]/).filter(Boolean).slice(0, 2).map(p => p[0].toUpperCase()).join('')
  : '?';
---

<header class="tbar" role="banner">
  <a href="/team" class="tbar__brand">Between Ops</a>
  <button class="tbar__menu" type="button" aria-controls="team-side" aria-expanded="false">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    Menu
  </button>
</header>

<div class="tside-backdrop" hidden></div>

<aside class="tside" id="team-side" aria-label="Team area">
  <a href="/team" class="tside__brand">
    <span class="tside__brand-name">Between Ops</span>
    <span class="tside__badge">Team only</span>
  </a>

  <nav class="tside__nav" aria-label="Team navigation">
    <ul role="list">
      {links.map(({ href, label, icon }) => (
        <li>
          <a href={href} class="tside__link" aria-current={isCurrent(href) ? 'page' : undefined}>
            <svg class="tside__icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" set:html={ICONS[icon]} />
            <span>{label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="tside__foot">
    <a href="/" class="tside__link tside__link--quiet">
      <svg class="tside__icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" set:html={ICONS.site} />
      <span>Public site</span>
    </a>
    <div class="tside__account">
      {authEmail ? (
        <>
          <span class="tside__avatar" aria-hidden="true">{initials}</span>
          <span class="tside__who">
            <span class="visually-hidden">Signed in as </span>
            <span class="tside__email">{authEmail}</span>
            <a href="/cdn-cgi/access/logout" class="tside__logout">Log out</a>
          </span>
        </>
      ) : (
        <span class="tside__email tside__email--warn">No Access identity (local dev)</span>
      )}
    </div>
  </div>
</aside>

<script>
  // The team app: register the service worker for notifications and the offline page.
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('/between-ops-sw.js', { scope: '/team' }).catch(() => {});
  }

  const side = document.getElementById('team-side');
  const toggle = document.querySelector<HTMLButtonElement>('.tbar__menu');
  const backdrop = document.querySelector<HTMLElement>('.tside-backdrop');
  if (side && toggle && backdrop) {
    const setOpen = (open: boolean) => {
      side.classList.toggle('is-open', open);
      backdrop.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      if (open) side.querySelector<HTMLElement>('[aria-current="page"], a')?.focus();
    };
    toggle.addEventListener('click', () => setOpen(!side.classList.contains('is-open')));
    backdrop.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && side.classList.contains('is-open')) { setOpen(false); toggle.focus(); }
    });
  }
</script>

<style is:global>
  /* Team pages sit to the right of the sidebar on desktop. */
  @media (min-width: 960px) {
    body.is-team { padding-left: 15rem; }
  }
</style>

<style>
  .tbar, .tside { font-family: var(--font-body); }
  .tbar__menu svg, .tside__icon { fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }

  /* ── Phone top bar ───────────────────────────────────────────────────── */
  .tbar {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    height: 3.25rem;
    padding: 0 var(--space-4);
    background: var(--ink);
    border-bottom: 1px solid var(--line);
  }
  .tbar__brand { color: var(--paper); font-weight: 700; font-size: var(--text-sm); text-decoration: none; }
  .tbar__menu {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font: inherit;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--paper);
    background: var(--ink-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.45rem 0.7rem;
    cursor: pointer;
  }


  /* ── Sidebar ─────────────────────────────────────────────────────────── */
  .tside {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 200;
    width: min(17rem, 85vw);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-5) var(--space-3);
    background: var(--ink);
    border-right: 1px solid var(--line);
    overflow-y: auto;
    transform: translateX(-100%);
    visibility: hidden;
    transition: transform 200ms ease, visibility 200ms;
  }
  .tside.is-open { transform: none; visibility: visible; box-shadow: 0 0 40px rgba(0, 0, 0, 0.5); }
  @media (prefers-reduced-motion: reduce) { .tside { transition: none; } }
  .tside-backdrop { position: fixed; inset: 0; z-index: 150; background: rgba(10, 6, 6, 0.6); }
  .tside-backdrop[hidden] { display: none; }

  .tside__brand { display: flex; align-items: center; gap: var(--space-2); padding: 0 0.75rem; text-decoration: none; }
  .tside__brand-name { color: var(--paper); font-weight: 700; font-size: var(--text-base); letter-spacing: -0.01em; }
  .tside__badge {
    font-size: 0.58rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink); background: var(--ember); padding: 0.1rem 0.4rem; border-radius: var(--radius-sm);
  }

  .tside__nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .tside__link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius);
    color: var(--body);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: background 150ms ease, color 150ms ease;
  }
  .tside__link:hover { color: var(--paper); background: rgba(255, 255, 255, 0.05); }
  .tside__link[aria-current='page'] { color: var(--paper); background: rgba(232, 162, 61, 0.14); }
  .tside__link[aria-current='page'] .tside__icon { color: var(--ember); }
  .tside__link[aria-current='page']::before {
    content: '';
    position: absolute;
    left: -0.75rem;
    top: 0.45rem;
    bottom: 0.45rem;
    width: 3px;
    border-radius: 0 3px 3px 0;
    background: var(--ember);
  }
  .tside__link--quiet { font-weight: 500; font-size: var(--text-xs); }
  .tside a:focus-visible, .tbar :focus-visible { outline: 3px solid var(--ember); outline-offset: 2px; }

  .tside__foot { margin-top: auto; display: flex; flex-direction: column; gap: var(--space-2); border-top: 1px solid var(--line); padding-top: var(--space-3); }
  .tside__account { display: flex; align-items: center; gap: 0.6rem; padding: 0 0.75rem; min-width: 0; }
  .tside__avatar {
    display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; flex-shrink: 0;
    background: var(--ink-soft); border: 1px solid var(--line); color: var(--paper); font-size: 0.7rem; font-weight: 700;
  }
  .tside__who { display: flex; flex-direction: column; min-width: 0; }
  .tside__email { font-size: 0.72rem; color: var(--body); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tside__email--warn { color: #ff8080; white-space: normal; }
  .tside__logout { font-size: 0.72rem; font-weight: 700; color: var(--ember); width: fit-content; }
  .tside__logout:hover { color: var(--paper); }

  .visually-hidden {
    position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  /* ── Desktop: sidebar always visible, no top bar ─────────────────────── */
  @media (min-width: 960px) {
    .tbar, .tside-backdrop { display: none; }
    .tside { width: 15rem; transform: none; visibility: visible; box-shadow: none; }
  }
</style>
