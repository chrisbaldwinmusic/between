---
// The comment inbox, shown on /team/social: public comments on our own Facebook and Instagram posts
// (src/lib/comments.js), kept with no names, for counts and themes in the outcomes report and to spot people
// worth inviting to share their story. Nothing here is published. Filters are query strings on the page.
import events from '../data/events.json';
import { getEmail, isLead } from '../lib/team-access.js';
import { THEMES, commentSummary, RETENTION_MONTHS } from '../lib/comments.js';

const lead = isLead(getEmail(Astro.request));
const db = Astro.locals.runtime?.env?.OPS_DB;
const q = Astro.url.searchParams;
const status = ['new', 'reviewed'].includes(q.get('status') ?? '') ? q.get('status')! : 'all';
const event = q.get('event') ?? '';

let comments: any[] = [];
let summary: any = null;
let missing = false;
let lastRefresh: { actor: string; detail: string; created_at: string } | null = null;
if (db) {
  try {
    const where = [`status != 'excluded'`];
    const args: string[] = [];
    if (status !== 'all') { where.push('status = ?'); args.push(status); }
    if (event === 'none') where.push('event_slug IS NULL');
    else if (event) { where.push('event_slug = ?'); args.push(event); }
    const { results } = await db
      .prepare(`SELECT id, platform, post_url, text, posted_at, likes, event_slug, themes, suggested_themes, status, ask_to_share, quote_ok, replied_at
                FROM social_comments WHERE ${where.join(' AND ')} ORDER BY posted_at DESC LIMIT 200`)
      .bind(...args).all();
    comments = results;
    summary = await commentSummary(db);
    lastRefresh = await db.prepare(`SELECT actor, detail, created_at FROM activity_log WHERE action = 'synced social comments' ORDER BY id DESC LIMIT 1`).first();
  } catch { missing = true; }
}
const eventName = (slug: string | null) => events.find(e => e.slug === slug)?.name ?? 'Not tied to an event';
const when = (iso: string) => new Date(iso.replace(' ', 'T') + 'Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const platformName = (p: string) => (p === 'facebook' ? 'Facebook' : 'Instagram');
const INVITE = 'Thank you, that means a lot. If you would like to tell us more, you can share your story here: https://between.sonicboom.org.uk/feedback/story?utm_source=social&utm_medium=comment-reply&utm_campaign=story-invite. It is optional and you choose whether we share it. Believe in the Power of Music.';
const draft = (platform: string) => `Thank you, that means a lot. If you'd like to tell us more, you can share your story here: https://between.sonicboom.org.uk/feedback/story?utm_source=${platform}&utm_medium=comment-reply&utm_campaign=story-invite It's optional, and you choose whether we share it. Believe in the Power of Music.`;
const tab = (key: string, label: string) => ({ key, label, href: `?status=${key}${event ? `&event=${event}` : ''}` });
const tabs = [tab('all', 'All'), tab('new', 'Waiting'), tab('reviewed', 'Tagged')];
---
<section id="comments" class="cm-wrap" aria-labelledby="cm-title" tabindex="-1">
  <div>
        <h2 class="cm-heading" id="cm-title">Comments inbox</h2>
        <p class="cm-intro">
          Public comments on our own Facebook and Instagram posts, with no names kept. Tag what you see so the
          outcomes report can count it. We never quote one word for word unless the person has agreed
          (see <a href="/privacy">the privacy notice</a>); otherwise paraphrase. Copies are deleted after
          {RETENTION_MONTHS} months, or when someone deletes the original.
        </p>

        {missing && <p class="cm-note" role="alert">The comments table isn't set up yet. Run <code>npx wrangler d1 execute between-ops --remote --file=d1/comments.sql</code>.</p>}

        {summary && (
          <>
            <div class="cm-stats">
              <p class="cm-stat"><strong>{summary.total}</strong> comments kept</p>
              <p class="cm-stat"><strong>{summary.waiting}</strong> waiting to be tagged</p>
              <p class="cm-stat"><strong>{summary.story_leads}</strong> to invite to share a story</p>
            </div>
            <h2 class="cm-sub">Themes so far</h2>
            <ul class="cm-themes" role="list">
              {THEMES.map(([k, l]) => <li><span>{l}</span> <strong>{summary.byTheme[k]}</strong></li>)}
            </ul>
          </>
        )}

        <div class="cm-bar">
          <nav aria-label="Filter comments" class="cm-tabs">
            {tabs.map(t => <a href={t.href} class:list={['cm-tab', { 'is-on': status === t.key }]} aria-current={status === t.key ? 'page' : undefined}>{t.label}</a>)}
          </nav>
          <form method="get" action="/team/social#comments" class="cm-filter">
            <input type="hidden" name="status" value={status} />
            <label for="cm-event">Event</label>
            <select id="cm-event" name="event" onchange="this.form.submit()">
              <option value="">All events</option>
              {events.map(e => <option value={e.slug} selected={event === e.slug}>{e.name}</option>)}
              <option value="none" selected={event === 'none'}>Not tied to an event</option>
            </select>
            <noscript><button class="ev-btn" type="submit">Filter</button></noscript>
          </form>
          <button class="ev-btn" type="button" id="cm-sync">Refresh comments</button>
          {comments.some(c => c.status === 'new') && <button class="ev-btn" type="button" id="cm-save-all">Save all as shown</button>}
          <span class="cm-msg" id="cm-sync-msg" role="status"></span>
        </div>

        {lastRefresh && (
          <p class="cm-last" role="status">
            <strong>Last refresh:</strong> {when(lastRefresh.created_at)} {new Date(lastRefresh.created_at.replace(' ', 'T') + 'Z').toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/London' })}, {lastRefresh.actor.replace(/@.*/, '')}. {lastRefresh.detail}
          </p>
        )}

        <details class="cm-invite">
          <summary>Reply wording to invite someone to share their story</summary>
          <p id="cm-invite-text">{INVITE}</p>
          <button class="ev-btn" type="button" id="cm-copy">Copy</button>
          <p class="cm-hint">Post it from <a href="/team/social">Social</a> or the app. Only invite people who sound like adults; if a commenter may be under 16, use "Don't use" and leave it.</p>
        </details>

        <ul class="cm-list" role="list">
          {comments.length === 0 && !missing && <li class="cm-empty">No comments here yet. They appear after the next daily refresh, or press "Refresh comments".</li>}
          {comments.map(c => (
            <li class={`cm cm--${c.status}`} data-id={c.id}>
              <form class="cm__form">
                <p class="cm__text">{c.text}</p>
                <p class="cm__meta">
                  {platformName(c.platform)} · {when(c.posted_at)} · {c.likes} {c.likes === 1 ? 'like' : 'likes'}
                  {c.post_url && <> · <a href={c.post_url} rel="noopener noreferrer" target="_blank">See the post <span class="visually-hidden">(opens in new tab)</span></a></>}
                </p>
                <div class="f">
                  <label for={`ev-${c.id}`}>Event</label>
                  <select id={`ev-${c.id}`} name="event_slug">
                    <option value="">Not tied to an event</option>
                    {events.map(e => <option value={e.slug} selected={c.event_slug === e.slug}>{e.name}</option>)}
                  </select>
                </div>
                <fieldset class="cm__themes" data-suggested={c.suggested_themes}>
                  <legend>What it shows</legend>
                  {THEMES.map(([k, l]) => (
                    <label class="cm__check"><input type="checkbox" name="themes" value={k} checked={(c.themes || (c.status !== 'reviewed' ? c.suggested_themes : '')).split(',').includes(k)} /> {l}</label>
                  ))}
                </fieldset>
                {c.suggested_themes && c.status !== 'reviewed' && !c.themes && (
                  <p class="cm__suggest">Ticked from an AI assistant's suggestion. <strong>Not counted until you check them and press Save tags.</strong></p>
                )}
                <label class="cm__check"><input type="checkbox" name="ask_to_share" checked={!!c.ask_to_share} /> Worth inviting to share their story</label>
                {c.replied_at && <p class="cm__meta"><strong>Story invitation sent</strong> {when(c.replied_at)}.</p>}
                {c.ask_to_share && c.status === 'reviewed' && !c.replied_at && (
                  <details class="cm__reply">
                    <summary>Reply with a story invitation</summary>
                    <label class="visually-hidden" for={`rp-${c.id}`}>Reply</label>
                    <textarea id={`rp-${c.id}`} name="reply_message" rows="4">{draft(c.platform)}</textarea>
                    <label class="cm__check"><input type="checkbox" name="adult_ok" /> I've read it and the commenter sounds like an adult</label>
                    <p class="cm-hint">This posts publicly from our {platformName(c.platform)} account and can't be unsent. Edit it to answer what they said.</p>
                    <button class="ev-btn ev-btn--primary" type="button" data-act="reply">Send reply</button>
                  </details>
                )}
                {lead && <label class="cm__check"><input type="checkbox" name="quote_ok" checked={!!c.quote_ok} /> They've agreed we can quote it word for word</label>}
                {!lead && c.quote_ok ? <p class="cm__meta"><strong>OK to quote word for word.</strong></p> : null}
                <div class="cm__actions">
                  <button class="ev-btn ev-btn--primary" type="button" data-act="save">Save tags</button>
                  <button class="ev-btn" type="button" data-act="exclude">Don't use</button>
                  {lead && <button class="ev-btn ev-btn--danger" type="button" data-act="delete">Delete</button>}
                  <span class="cm-msg" role="status"></span>
                </div>
              </form>
            </li>
          ))}
        </ul>
  </div>
</section>

<script>
  // Reload but stay at the inbox (the page above it is long).
  const stayOnInbox = () => { location.hash = 'comments'; location.reload(); };
  const send = (url: string, method: string, body?: unknown) =>
    fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: body ? JSON.stringify(body) : undefined });

  // What a comment's form currently shows, as the tags to save.
  function formBody(form: HTMLFormElement) {
    const fd = new FormData(form);
    const body: Record<string, unknown> = {
      status: 'reviewed',
      event_slug: fd.get('event_slug') || null,
      themes: fd.getAll('themes'),
      ask_to_share: fd.get('ask_to_share') === 'on',
    };
    if (form.elements.namedItem('quote_ok')) body.quote_ok = fd.get('quote_ok') === 'on';
    return body;
  }

  // Saves every comment still waiting, exactly as its form shows now (suggested ticks included).
  document.getElementById('cm-save-all')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const msg = document.getElementById('cm-sync-msg')!;
    // Only comments with at least one theme ticked: an untagged comment stays in Waiting.
    const items = Array.from(document.querySelectorAll<HTMLLIElement>('li.cm--new'))
      .filter(li => li.querySelector('input[name="themes"]:checked'));
    if (!items.length) { msg.textContent = 'Nothing to save: no waiting comment has a theme ticked.'; return; }
    if (!confirm(`Save tags for ${items.length} comments exactly as shown? Ticked suggestions will count as tags, so skim them first. Comments with nothing ticked stay in Waiting.`)) return;
    btn.disabled = true;
    let done = 0, failed = 0;
    for (const li of items) {
      msg.textContent = `Saving ${done + failed + 1} of ${items.length}…`;
      const res = await send(`/api/team/comments/${li.dataset.id}`, 'PATCH', formBody(li.querySelector('form') as HTMLFormElement));
      if (res.ok) done++; else failed++;
    }
    msg.textContent = failed ? `Saved ${done}, ${failed} failed. Reload and try again.` : `Saved ${done}. Reloading…`;
    if (failed) btn.disabled = false; else setTimeout(() => stayOnInbox(), 800);
  });

  document.getElementById('cm-sync')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const msg = document.getElementById('cm-sync-msg')!;
    btn.disabled = true; msg.textContent = 'Refreshing…';
    const res = await send('/api/team/comments/sync', 'POST');
    const j = await res.json().catch(() => ({}));
    if (res.ok) {
      const by = j.by ?? {};
      const line = `Facebook: ${by.facebook?.posts ?? 0} posts, ${by.facebook?.comments ?? 0} comments kept. Instagram: ${by.instagram?.posts ?? 0} posts, ${by.instagram?.comments ?? 0} comments kept. Removed ${j.removed}.`;
      if (j.errors?.length) { msg.textContent = `${line} Problems: ${j.errors.join(' | ')}`; btn.disabled = false; }
      else { msg.textContent = `${line} Reloading…`; setTimeout(() => stayOnInbox(), 1200); }
    } else { msg.textContent = j.error || 'Could not refresh comments'; btn.disabled = false; }
  });

  document.getElementById('cm-copy')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    try { await navigator.clipboard.writeText(document.getElementById('cm-invite-text')!.textContent || ''); btn.textContent = 'Copied'; }
    catch { btn.textContent = 'Select the text and copy'; }
  });

  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-act]') as HTMLButtonElement | null;
    const li = btn?.closest('li.cm') as HTMLLIElement | null;
    if (!btn || !li) return;
    const msg = li.querySelector('.cm-msg')!;
    const id = li.dataset.id;
    const form = li.querySelector('form') as HTMLFormElement;

    if (btn.dataset.act === 'suggest') {
      const picks = (li.querySelector('fieldset')?.getAttribute('data-suggested') || '').split(',');
      li.querySelectorAll<HTMLInputElement>('input[name="themes"]').forEach(i => { i.checked = picks.includes(i.value); });
      msg.textContent = 'Ticked. Check them, then Save tags.';
      return;
    }
    if (btn.dataset.act === 'reply') {
      const message = (form.elements.namedItem('reply_message') as HTMLTextAreaElement).value;
      const adult = (form.elements.namedItem('adult_ok') as HTMLInputElement).checked;
      if (!adult) { msg.textContent = 'Tick the box to confirm they sound like an adult.'; return; }
      if (!confirm('Post this reply publicly? It can\'t be unsent.')) return;
      btn.disabled = true; msg.textContent = 'Sending…';
      const res = await send(`/api/team/comments/${id}/reply`, 'POST', { message, adult_ok: true });
      if (res.ok) { msg.textContent = 'Sent. Reloading…'; setTimeout(() => stayOnInbox(), 800); }
      else { const j = await res.json().catch(() => ({})); msg.textContent = j.error || 'Could not send'; btn.disabled = false; }
      return;
    }
    if (btn.dataset.act === 'delete') {
      if (!confirm('Delete our copy of this comment? Use this if someone asks us to.')) return;
      const res = await send(`/api/team/comments/${id}`, 'DELETE');
      if (res.ok) li.remove(); else msg.textContent = 'Could not delete';
      return;
    }
    if (btn.dataset.act === 'exclude') {
      if (!confirm("Don't use this comment? Its text is deleted from our records, and can't be got back.")) return;
      const res = await send(`/api/team/comments/${id}`, 'PATCH', { status: 'excluded' });
      if (res.ok) li.remove(); else msg.textContent = 'Could not save';
      return;
    }
    const body = formBody(form);
    btn.disabled = true; msg.textContent = 'Saving…';
    const res = await send(`/api/team/comments/${id}`, 'PATCH', body);
    if (res.ok) { msg.textContent = 'Saved'; li.classList.remove('cm--new'); li.classList.add('cm--reviewed'); btn.disabled = false; if (body.ask_to_share) setTimeout(() => stayOnInbox(), 600); }
    else { const j = await res.json().catch(() => ({})); msg.textContent = j.error || 'Could not save'; btn.disabled = false; }
  });
</script>

<style>
  .cm-wrap { margin-top: var(--space-12); padding-top: var(--space-8); border-top: 1px solid var(--line); scroll-margin-top: var(--space-6); }
  .cm-wrap:focus-visible { outline: 3px solid var(--ember); outline-offset: 4px; }
  .visually-hidden { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .cm-heading { font-family: var(--font-body); color: var(--paper); font-size: var(--text-xl); margin-bottom: var(--space-2); }
  .cm-sub { font-family: var(--font-body); font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--body); margin: var(--space-6) 0 var(--space-3); }
  .cm-intro { color: var(--body); font-size: var(--text-sm); max-width: 70ch; margin-bottom: var(--space-6); }
  .cm-intro a, .cm__meta a, .cm-hint a { color: var(--ember); }
  .cm-note { color: var(--paper); background: var(--ink-soft); border: 1px solid var(--red); border-radius: var(--radius); padding: var(--space-3) var(--space-4); font-size: var(--text-sm); }
  .cm-stats { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6); }
  .cm-stat { margin: 0; color: var(--body); font-size: var(--text-sm); }
  .cm-stat strong { color: var(--paper); font-size: var(--text-xl); margin-right: 0.3rem; }
  .cm-themes { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .cm-themes li { background: var(--ink-soft); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 0.35rem 0.7rem; font-size: var(--text-xs); color: var(--body); }
  .cm-themes strong { color: var(--ember); margin-left: 0.3rem; }
  .cm-bar { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-4); margin: var(--space-8) 0 var(--space-4); }
  .cm-tabs { display: flex; gap: var(--space-1); }
  .cm-tab { font-size: var(--text-xs); font-weight: 600; color: var(--body); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 0.5rem 0.8rem; text-decoration: none; }
  .cm-tab.is-on { background: var(--red); border-color: var(--red); color: #fff; }
  .cm-tab:focus-visible { outline: 3px solid var(--ember); outline-offset: 2px; }
  .cm-filter { display: flex; align-items: center; gap: var(--space-2); }
  .cm-filter label, .f label { font-size: 0.7rem; font-weight: 600; color: var(--body); }
  select { font-family: var(--font-body); font-size: var(--text-sm); color: var(--paper); background: var(--ink); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 0.45rem 0.6rem; max-width: 100%; }
  select:focus-visible, .ev-btn:focus-visible, input:focus-visible, summary:focus-visible { outline: 3px solid var(--ember); outline-offset: 2px; }
  .cm-invite { background: var(--ink-soft); border: 1px solid var(--line); border-radius: var(--radius); padding: var(--space-3) var(--space-4); margin-bottom: var(--space-6); color: var(--body); font-size: var(--text-sm); }
  .cm-invite summary { cursor: pointer; color: var(--paper); font-weight: 600; }
  .cm-invite p { margin: var(--space-3) 0; }
  .cm-hint { font-size: var(--text-xs); }
  .cm-last { background: var(--ink-soft); border: 1px solid var(--line); border-radius: var(--radius); padding: var(--space-3) var(--space-4); margin: 0 0 var(--space-4); color: var(--body); font-size: var(--text-xs); overflow-wrap: anywhere; }
  .cm-last strong { color: var(--paper); }
  .cm-empty, .cm-msg { font-size: var(--text-sm); color: var(--body); }
  .cm-msg { font-size: var(--text-xs); }
  .cm-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  @media (min-width: 1000px) { .cm-list { grid-template-columns: 1fr 1fr; } }
  .cm { background: var(--ink-soft); border: 1px solid var(--line); border-left: 4px solid var(--ember); border-radius: var(--radius); padding: var(--space-4); }
  .cm--reviewed { border-left-color: #4caf50; }
  .cm__form { display: flex; flex-direction: column; gap: var(--space-3); }
  .cm__text { margin: 0; color: var(--paper); line-height: 1.5; white-space: pre-line; overflow-wrap: anywhere; }
  .cm__reply { border: 1px solid var(--line); border-radius: var(--radius-sm); padding: var(--space-3); display: flex; flex-direction: column; gap: var(--space-2); }
  .cm__reply summary { cursor: pointer; color: var(--paper); font-size: var(--text-sm); font-weight: 600; }
  .cm__reply textarea { font-family: var(--font-body); font-size: var(--text-sm); color: var(--paper); background: var(--ink); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 0.5rem 0.65rem; width: 100%; margin-top: var(--space-2); }
  .cm__reply textarea:focus-visible { outline: 3px solid var(--ember); outline-offset: 2px; }
  .cm__suggest { margin: 0; font-size: var(--text-xs); color: var(--body); display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); }
  .cm__suggest strong { color: var(--ember); }
  .cm__meta { margin: 0; font-size: var(--text-xs); color: var(--body); }
  .cm__themes { border: 0; margin: 0; padding: 0; display: grid; gap: var(--space-1) var(--space-4); grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); }
  .cm__themes legend { font-size: 0.7rem; font-weight: 600; color: var(--body); padding: 0; margin-bottom: var(--space-1); }
  .cm__check { display: flex; align-items: center; gap: 0.5rem; font-size: var(--text-sm); color: var(--paper); min-height: 2rem; }
  .cm__check input { width: 1.1rem; height: 1.1rem; accent-color: var(--red); }
  .f { display: flex; flex-direction: column; gap: 0.2rem; }
  .cm__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); }
  .ev-btn { font-family: var(--font-body); font-size: var(--text-xs); font-weight: 600; color: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 0.5rem 0.8rem; background: transparent; }
  .ev-btn:hover { border-color: var(--ember); color: var(--ember); }
  .ev-btn--primary { background: var(--red); border-color: var(--red); color: #fff; }
  .ev-btn--primary:hover { color: #fff; background: #a50d26; }
  .ev-btn--danger:hover { border-color: #ff8080; color: #ff8080; }
  code { font-size: 0.85em; }
</style>
