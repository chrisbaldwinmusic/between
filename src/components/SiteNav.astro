---
// Root-relative so they work from sub-pages (events, privacy) as well as the home page.
const navLinks = [
  { href: '/#idea',          label: 'The idea'       },
  { href: '/#the-year',      label: 'The year'       },
  { href: '/#how-it-works',  label: 'How it works'   },
  { href: '/#membership',    label: 'Membership'     },
  { href: '/#the-ambition',  label: 'The ambition'   },
  { href: '/#get-involved',  label: 'Get involved'   },
  { href: '/#access',        label: 'Access'         },
];
---

<header class="site-nav" role="banner">
  <div class="site-nav__inner container">

    <a href="/" class="site-nav__brand" aria-label="The Space Between homepage">
      <span class="site-nav__brand-name">The Space Between</span>
      <span class="site-nav__brand-by" aria-hidden="true">Sonic Boom Music CIC</span>
    </a>

    <nav id="primary-nav" class="site-nav__links" aria-label="Primary navigation" hidden>
      <ul role="list">
        {navLinks.map(({ href, label }) => (
          <li><a href={href} class="site-nav__link">{label}</a></li>
        ))}
        <li class="site-nav__menu-only"><a href="/team" class="site-nav__link site-nav__link--team">Team login</a></li>
      </ul>
    </nav>

    <a href="/team" class="site-nav__team">Team<span class="sr-only"> login</span></a>

    <a href="/#signup" class="btn btn-primary site-nav__cta">
      <span>Join<span class="site-nav__cta-rest"> the community</span></span>
    </a>

    <button
      class="site-nav__toggle"
      aria-controls="primary-nav"
      aria-expanded="false"
      aria-label="Open navigation menu"
    >
      <span class="site-nav__hamburger" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
    </button>

  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--ink);
    border-bottom: 1px solid var(--line);
  }

  .site-nav__inner {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    height: var(--nav-h);
  }

  /* ── Brand ─────────────────────────────────────────── */
  .site-nav__brand {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    text-decoration: none;
    min-width: 0;
    margin-right: auto;
  }
  .site-nav__brand-name {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--paper);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .site-nav__brand-by {
    font-family: var(--font-body);
    font-size: 0.6rem;
    font-weight: 600;
    color: var(--ember);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .site-nav__brand:hover .site-nav__brand-name { color: var(--ember); }

  /* ── CTA: "Join" on phones, "Join the community" when there's room ── */
  .site-nav__cta {
    flex-shrink: 0;
    font-size: var(--text-sm);
    padding: 0.55rem 1rem;
  }
  .site-nav__cta-rest {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* Team: inside the menu on phones, a quiet text link on desktop. */
  .site-nav__team { display: none; }

  /* ── Hamburger ──────────────────────────────────────── */
  .site-nav__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.5rem;
    border-radius: var(--radius);
    color: var(--paper);
    flex-shrink: 0;
  }
  .site-nav__toggle:hover { color: var(--ember); }

  .site-nav__hamburger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 20px;
  }
  .site-nav__hamburger span {
    display: block;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
    transition: transform var(--duration) var(--ease), opacity var(--duration) var(--ease);
  }
  .site-nav__toggle[aria-expanded="true"] .site-nav__hamburger span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .site-nav__toggle[aria-expanded="true"] .site-nav__hamburger span:nth-child(2) {
    opacity: 0;
  }
  .site-nav__toggle[aria-expanded="true"] .site-nav__hamburger span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .site-nav__hamburger span { transition: none; }
  }

  /* ── Mobile menu panel ──────────────────────────────── */
  .site-nav__links {
    position: absolute;
    top: var(--nav-h);
    left: 0;
    right: 0;
    background: var(--ink-soft);
    border-bottom: 1px solid var(--line);
    padding: var(--space-2) 0 var(--space-4);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.35);
  }
  .site-nav__links ul {
    display: flex;
    flex-direction: column;
  }
  .site-nav__link {
    display: block;
    padding: var(--space-3) clamp(var(--space-4), 5vw, var(--space-10));
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--paper);
    text-decoration: none;
    transition: color var(--duration) var(--ease), background var(--duration) var(--ease);
  }
  .site-nav__link:hover {
    color: var(--ember);
    background: rgba(255,255,255,0.04);
  }
  .site-nav__menu-only {
    margin-top: var(--space-2);
    border-top: 1px solid var(--line);
    padding-top: var(--space-2);
  }
  .site-nav__link--team { font-size: var(--text-sm); color: var(--body); }

  .site-nav a:focus-visible,
  .site-nav__toggle:focus-visible {
    outline: 3px solid var(--ember);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  @media (min-width: 480px) {
    .site-nav__cta-rest { position: static; width: auto; height: auto; overflow: visible; clip: auto; }
  }

  /* ── Desktop: everything in one row ─────────────────── */
  @media (min-width: 1240px) {
    .site-nav__inner { gap: var(--space-3); }
    .site-nav__brand { margin-right: 0; flex-shrink: 0; }
    .site-nav__toggle { display: none; }

    .site-nav__links {
      position: static;
      background: transparent;
      border: none;
      box-shadow: none;
      padding: 0;
      flex: 1;
      display: block !important; /* override hidden attr */
    }
    .site-nav__links { min-width: 0; }
    .site-nav__links ul {
      flex-direction: row;
      gap: 0;
      justify-content: safe center;
    }
    .site-nav__link {
      padding: var(--space-2) 0.6rem;
      font-size: var(--text-sm);
      color: var(--body);
      border-radius: var(--radius-sm);
      white-space: nowrap;
    }
    .site-nav__link:hover { color: var(--paper); }
    .site-nav__menu-only { display: none; }

    .site-nav__team {
      display: block;
      font-family: var(--font-body);
      font-size: var(--text-xs);
      font-weight: 600;
      color: var(--body);
      text-decoration: none;
      padding: var(--space-2);
      white-space: nowrap;
    }
    .site-nav__team:hover { color: var(--paper); }
  }
</style>

<script>
  const toggle = document.querySelector('.site-nav__toggle') as HTMLButtonElement | null;
  const nav    = document.getElementById('primary-nav') as HTMLElement | null;
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      toggle.setAttribute('aria-label', open ? 'Open navigation menu' : 'Close navigation menu');
      nav.hidden = open;
    });

    /* Escape closes the menu and returns focus to the button */
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open navigation menu');
        nav.hidden = true;
        toggle.focus();
      }
    });

    /* Close nav when any anchor link is clicked */
    nav.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open navigation menu');
        nav.hidden = true;
      });
    });
  }
</script>
